<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Customers | Fitpro Equips</title>
	<link rel="stylesheet" href="/css/admin-dashboard.css">
	<link rel="stylesheet" href="/css/customers.css">
</head>
<body>
	<div class="admin-dashboard">
		<!-- Sidebar Partial -->
		<%- include('../partials/admin-sidebar.ejs', { currentPage: 'customers' }) %>

		<!-- Main Content -->
		<main class="main-content">
			<!-- Page Title Section -->
			<div class="page-header">
				<div>
					<h1>Customer Management</h1>
					<p>Monitor customer accounts, purchase history, and engagement analytics.</p>
				</div>
			</div>

			<!-- Stats Grid -->
			<section class="stats-grid">
				<div class="stat-card">
					<div class="stat-header">
						<span class="stat-icon customers">👥</span>
						<span class="stat-change up">+12.5%</span>
					</div>
					<p class="stat-label">TOTAL CUSTOMERS</p>
					<p class="stat-value"><%= totalUsers || 0 %></p>
				</div>

				<div class="stat-card">
					<div class="stat-header">
						<span class="stat-icon new">👤</span>
						<span class="stat-change up">+8.2%</span>
					</div>
					<p class="stat-label">NEW TODAY</p>
					<p class="stat-value">18</p>
				</div>

				<div class="stat-card">
					<div class="stat-header">
						<span class="stat-icon active">⚡</span>
						<span class="stat-change">90% of total</span>
					</div>
					<p class="stat-label">ACTIVE USERS</p>
					<p class="stat-value"><%= activeCount || 0 %></p>
				</div>

				<div class="stat-card">
					<div class="stat-header">
						<span class="stat-icon blocked">🚫</span>
						<span class="stat-change down">-2.4%</span>
					</div>
					<p class="stat-label">BLOCKED</p>
					<p class="stat-value"><%= blockedCount || 0 %></p>
				</div>
			</section>

			<!-- Customers Table Section -->
			<section class="content-section">
				<div class="card">
					<!-- Search and Filter Bar -->
					<div class="filter-section">
					<form id="searchForm" method="GET" action="/admin/customers" class="search-box">
						<span class="search-icon">🔍</span>
						<input type="text" id="searchInput" name="search" placeholder="Search by Name, Email, ID..." class="search-input" value="<%= searchQuery || '' %>">
						<button type="submit" class="search-btn">Search</button>					<% if (searchQuery) { %>
						<button type="button" id="clearSearchBtn" class="clear-btn" title="Clear search">✕ Clear</button>
					<% } %>					</form>
					<select id="statusFilter" class="filter-select">
						<option value="">Status: All</option>
						<option value="active">Active</option>
						<option value="inactive">Inactive</option>
						<option value="blocked">Blocked</option>
					</select>
					</div>

					<!-- Customers Table -->
					<table class="customers-table">
						<thead>
							<tr>
								<th>CUSTOMER</th>
								<th>CUSTOMER ID</th>
								<th>JOINED DATE</th>
								<th>ORDERS</th>
								<th>STATUS</th>
								<th>ACTIONS</th>
							</tr>
						</thead>
						<tbody>
							<% if (users && users.length > 0) { %>
								<% users.forEach((user, index) => { %>
									<tr>
										<td>
											<div class="customer-cell">
												<div class="customer-avatar">👤</div>
												<div class="customer-info">
													<strong><%= user.name || 'N/A' %></strong>
													<small><%= user.email || 'N/A' %></small>
												</div>
											</div>
										</td>
										<td>#AV-<%= String(index + 1).padStart(5, '0') %></td>
										<td><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN') : 'N/A' %></td>
										<td><%= user.orders ? user.orders.length : 0 %></td>
										<td>
											<span class="status-badge <%= user.isBlocked ? 'blocked' : 'active' %>">
												<%= user.isBlocked ? 'BLOCKED' : 'ACTIVE' %>
											</span>
										</td>
										<td>
											<div class="action-buttons">
												<button class="action-btn view-btn" title="View" data-userid="<%= user._id %>">👁️</button>

												<button class="action-btn block-btn" title="Block/Unblock" data-userid="<%= user._id %>" data-isblocked="<%= user.isBlocked %>">🚫</button>
											</div>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="6" style="text-align: center; padding: 30px;">No customers found</td>
								</tr>
							<% } %>
						</tbody>
					</table>

					<!-- Pagination -->
					<div class="pagination-section">
						<span class="pagination-info">Showing 1-10 of <%= totalUsers || 0 %> customers</span>
						<div class="pagination">
							<% if (page > 1) { %>
								<button class="page-btn">Previous</button>
							<% } else { %>
								<button class="page-btn" disabled>Previous</button>
							<% } %>
							
							<% for (let i = 1; i <= totalPages; i++) { %>
								<% if (i === page) { %>
									<button class="page-btn active"><%= i %></button>
								<% } else { %>
									<a href="/admin/customers?page=<%= i %><%= searchQuery ? '&search=' + searchQuery : '' %>" class="page-btn"><%= i %></a>
								<% } %>
							<% } %>
							
							<% if (page < totalPages) { %>
								<button class="page-btn">Next</button>
							<% } else { %>
								<button class="page-btn" disabled>Next</button>
							<% } %>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>

	<!-- Block/Unblock Modal -->
	<div id="blockUnblockModal" class="modal-overlay hidden">
		<div class="modal-content">
			<div class="modal-header">
				<h3 class="modal-title" id="blockModalTitle">Block Customer</h3>
				<button class="modal-close" id="closeBlockModal">&times;</button>
			</div>
			<div class="modal-body">
				<p id="blockModalMessage">Are you sure you want to block this customer?</p>
			</div>
			<div class="modal-footer">
				<button id="cancelBlock" class="btn-secondary">Cancel</button>
				<button id="confirmBlock" class="btn-danger">Yes, Proceed</button>
			</div>
		</div>
	</div>

	<!-- Footer Partial (Logout Modal) -->
	<%- include('../partials/admin-footer.ejs') %>
	<script src="/js/customers.js"></script>
</body>
</html>