<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | Fitpro Equips Admin</title>
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/admin-scale.css">
    <style>
        :root {
            --detail-blue: #075bd6;
            --detail-ink: #202c3d;
            --detail-muted: #758198;
            --detail-line: #e0e6f0;
            --detail-bg: #f6f8ff;
        }

        body:has(.admin-order-detail) { background: var(--detail-bg); color: var(--detail-ink); }
        .admin-order-detail { display: grid; grid-template-columns: clamp(164px, 16.3vw, 198px) minmax(0, 1fr); min-height: 100vh; }
        .admin-order-detail > .sidebar { width: clamp(164px, 16.3vw, 198px); }
        .detail-main { grid-column: 2; min-width: 0; padding: 0 27px 30px; }

        .detail-topbar { display: flex; height: 51px; align-items: center; justify-content: space-between; gap: 12px; margin: 0 -27px 17px; padding: 0 17px; border-bottom: 1px solid #e1e6ef; background: rgba(255,255,255,.76); }
        .global-search { position: relative; width: min(100%, 245px); }
        .global-search svg { position: absolute; top: 50%; left: 8px; width: 12px; height: 12px; color: #7c8799; transform: translateY(-50%); pointer-events: none; }
        .global-search input { width: 100%; height: 26px; padding: 0 8px 0 26px; border: 1px solid #d9e1ef; border-radius: 5px; outline: none; color: #35435a; background: #f2f5fd; font: inherit; font-size: 9px; }
        .topbar-actions { display: flex; align-items: center; gap: 17px; }
        .topbar-notice { display: grid; width: 20px; height: 22px; place-items: center; border: 0; color: #526078; background: transparent; }
        .topbar-notice svg { width: 13px; height: 13px; }
        .topbar-support { color: #075bd6; font-size: 9px; font-weight: 650; text-decoration: none; }

        .detail-breadcrumb { display: flex; align-items: center; gap: 6px; margin-bottom: 11px; color: #8591a4; font-size: 8px; }
        .detail-breadcrumb a { color: inherit; text-decoration: none; }
        .detail-breadcrumb a:hover { color: var(--detail-blue); }
        .detail-breadcrumb span:last-child { color: var(--detail-blue); }

        .order-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 10px; }
        .order-heading-main { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
        .order-heading h1 { margin: 0; color: var(--detail-ink); font-size: 16px; line-height: 1.2; }
        
        /* Status Selector Dropdown Styling */
        .status-select { height: 28px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 10px; font-weight: 600; color: #08764a; background: #d9f7e9; cursor: pointer; outline: none; }

        .heading-actions { display: flex; align-items: center; gap: 5px; }
        .print-button, .download-button { display: inline-flex; min-height: 24px; align-items: center; justify-content: center; gap: 5px; padding: 0 8px; border: 1px solid #dbe4f2; border-radius: 5px; color: #334159; background: #eaf0ff; font: inherit; font-size: 7px; cursor: pointer; text-decoration: none; }
        .print-button:hover, .download-button:hover { background: #dce8ff; }
        .print-button svg, .download-button svg { width: 10px; height: 10px; }
        .download-button { width: 24px; padding: 0; }

        .detail-meta-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; width: min(100%, 365px); margin: 0 auto 12px; }
        .detail-meta-card { min-height: 37px; padding: 7px 9px; border: 1px solid #e4e9f2; border-radius: 6px; background: #fff; }
        .detail-meta-label { display: block; margin-bottom: 4px; color: #7b879b; font-size: 7px; text-transform: uppercase; }
        .detail-meta-value { display: block; color: #263449; font-size: 8px; font-weight: 650; }
        .detail-meta-value .paid { color: #087a4d; }

        .detail-panel { border: 1px solid var(--detail-line); border-radius: 7px; background: #fff; box-shadow: 0 3px 12px rgba(29, 52, 88, .035); }
        .logistics-panel { margin-bottom: 12px; padding: 16px 13px 12px; }
        .panel-kicker { margin: 0 0 15px; color: #4c586d; font-size: 8px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
        
        .detail-content-grid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(150px, .95fr); align-items: start; gap: 11px; }
        .detail-left-column, .detail-right-column { display: grid; gap: 10px; min-width: 0; }
        .products-panel { overflow: hidden; }
        .products-panel-header { display: flex; align-items: center; justify-content: space-between; padding: 10px 11px; color: #425067; font-size: 8px; }
        .products-table { width: 100%; border-collapse: collapse; text-align: left; }
        .products-table thead { background: #f2f5fd; }
        .products-table th { height: 23px; padding: 0 9px; color: #66738a; font-size: 7px; font-weight: 550; }
        .products-table td { padding: 7px 9px; color: #334158; font-size: 7px; }
        .product-cell { display: flex; min-width: 0; align-items: center; gap: 7px; }
        .product-photo { display: grid; width: 27px; height: 27px; flex: 0 0 27px; place-items: center; overflow: hidden; border-radius: 4px; background: #f1f3f7; }
        .product-photo img { width: 100%; height: 100%; object-fit: cover; }
        .product-title { display: block; max-width: 120px; color: #29364b; font-size: 7px; font-weight: 650; line-height: 1.35; }
        .products-table .number-cell { white-space: nowrap; }
        .products-table .subtotal-cell { color: #29364b; font-weight: 700; white-space: nowrap; }

        .side-panel { padding: 11px 10px; }
        .side-panel .panel-kicker { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
        .customer-identity { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; }
        .customer-photo { display: grid; width: 24px; height: 24px; flex: 0 0 24px; place-items: center; border-radius: 50%; color: #fff; background: #92a79a; font-size: 8px; font-weight: 650; }
        .customer-display-name { display: block; color: #28354a; font-size: 7px; font-weight: 650; }
        .customer-id { display: block; margin-top: 2px; color: #8490a1; font-size: 6px; }
        .customer-detail { display: flex; gap: 6px; margin-top: 7px; color: #526078; font-size: 6px; line-height: 1.45; }
        .customer-detail svg { width: 9px; height: 9px; flex: 0 0 9px; color: #75839a; }

        .shipping-address { margin: 0 0 6px; color: #35435a; font-size: 6px; line-height: 1.5; }

        .summary-line { display: flex; justify-content: space-between; gap: 6px; margin: 0 0 7px; color: #69768b; font-size: 6px; }
        .summary-line strong { color: #303c50; font-weight: 600; white-space: nowrap; }
        .summary-line .free { color: #087b4e; }
        .summary-line .negative { color: #c73a44; }
        .summary-total { display: flex; justify-content: space-between; gap: 6px; margin-top: 8px; padding-top: 8px; border-top: 1px solid #e6ebf3; color: #29364b; font-size: 7px; font-weight: 700; }
        .summary-total strong { color: #075bd6; font-size: 8px; }
    </style>
</head>
<body>
    <div class="admin-dashboard admin-order-detail">
        <%- include('../partials/admin-sidebar.ejs', { currentPage: 'orders' }) %>

        <main class="detail-main">
            <header class="detail-topbar">
                <label class="global-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
                    <input type="search" placeholder="Search..." aria-label="Search admin">
                </label>
                <div class="topbar-actions">
                    <button class="topbar-notice" type="button" aria-label="Notifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"></path></svg></button>
                    <a class="topbar-support" href="#support">Support</a>
                </div>
            </header>

            <nav class="detail-breadcrumb" aria-label="Breadcrumb">
                <a href="/admin/dashboard">Dashboard</a><span aria-hidden="true">›</span>
                <a href="/admin/orders">Orders</a><span aria-hidden="true">›</span>
                <span>Order Details</span>
            </nav>

            <section class="order-heading">
                <div class="order-heading-main">
                    <h1>#<%= order.orderId %></h1>
                    <!-- Interactive Status Changer (Task A.iii) -->
                    <select id="orderStatusSelect" class="status-select">
                        <option value="Pending" <%= order.orderStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Processing" <%= order.orderStatus === 'Processing' ? 'selected' : '' %>>Processing</option>
                        <option value="Packed" <%= order.orderStatus === 'Packed' ? 'selected' : '' %>>Packed</option>
                        <option value="Shipped" <%= order.orderStatus === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                        <option value="Out for Delivery" <%= order.orderStatus === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
                        <option value="Delivered" <%= order.orderStatus === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                        <option value="Returned" <%= order.orderStatus === 'Returned' ? 'selected' : '' %>>Returned</option>
                        <option value="Cancelled" <%= order.orderStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                </div>
                <div class="heading-actions">
                    <a href="/admin/orders/<%= order._id %>/invoice?preview=1" class="print-button" target="_blank" rel="noopener">Print Invoice</a>
                    <a href="/admin/orders/<%= order._id %>/invoice" class="download-button" aria-label="Download invoice" title="Download invoice"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v11m0 0 4-4m-4 4-4-4"></path><path d="M5 16v4h14v-4"></path></svg></a>
                </div>
            </section>

            <section class="detail-meta-grid" aria-label="Order metadata">
                <article class="detail-meta-card">
                    <span class="detail-meta-label">Date</span>
                    <strong class="detail-meta-value"><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
                </article>
                <article class="detail-meta-card">
                    <span class="detail-meta-label">Payment</span>
                    <strong class="detail-meta-value"><%= order.paymentMethod %> <span class="paid">(<%= order.paymentStatus || 'Paid' %>)</span></strong>
                </article>
                <article class="detail-meta-card">
                    <span class="detail-meta-label">Invoice</span>
                    <strong class="detail-meta-value">#INV-<%= order.orderId.substring(order.orderId.length - 5) %></strong>
                </article>
            </section>

            <div class="detail-content-grid">
                <div class="detail-left-column">
                    <section class="detail-panel products-panel" aria-labelledby="productsTitle">
                        <header class="products-panel-header"><strong id="productsTitle">Ordered Products</strong><span><%= order.items.length %> Items</span></header>
                        <div class="products-table-wrap">
                            <table class="products-table">
                                <thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead>
                                <tbody>
                                    <% order.items.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <div class="product-cell">
                                                <span class="product-photo"><img src="<%= item.image %>" alt="<%= item.name %>"></span>
                                                <span><span class="product-title"><%= item.name %></span></span>
                                            </div>
                                        </td>
                                        <td class="number-cell"><%= item.quantity %></td>
                                        <td class="number-cell">₹<%= item.price.toLocaleString('en-IN') %></td>
                                        <td class="subtotal-cell">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>

                <aside class="detail-right-column" aria-label="Customer and order summary">
                    <section class="detail-panel side-panel" aria-labelledby="customerTitle">
                        <h2 class="panel-kicker" id="customerTitle">Customer</h2>
                        <div class="customer-identity">
                            <span class="customer-photo">
                                <%= order.shippingAddress.name.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase() %>
                            </span>
                            <span>
                                <span class="customer-display-name"><%= order.shippingAddress.name %></span>
                                <span class="customer-id">ID: #CUST-<%= order.userId ? order.userId._id.toString().substring(0,5) : 'GUEST' %></span>
                            </span>
                        </div>
                        <p class="customer-detail">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
                            <span>Email<br><%= order.userId ? order.userId.email : 'N/A' %></span>
                        </p>
                        <p class="customer-detail">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 3.1 5.2 2 2 0 0 1 5.1 3h3a2 2 0 0 1 2 1.7l.4 2.7a2 2 0 0 1-.6 1.7L8 11a16 16 0 0 0 5 5l1.9-1.9a2 2 0 0 1 1.7-.6l2.7.4a2 2 0 0 1 1.7 2Z"></path></svg>
                            <span>Phone<br><%= order.shippingAddress.phone %></span>
                        </p>
                    </section>

                    <section class="detail-panel side-panel" aria-labelledby="shippingTitle">
                        <h2 class="panel-kicker" id="shippingTitle">Shipping Address</h2>
                        <p class="customer-display-name" style="margin-bottom:5px;"> <%= order.shippingAddress.name %> </p>
                        <p class="shipping-address"><%= order.shippingAddress.fullAddress %></p>
                    </section>

                    <section class="detail-panel side-panel" aria-labelledby="summaryTitle">
                        <h2 class="panel-kicker" id="summaryTitle">Order Summary</h2>
                        <p class="summary-line"><span>Subtotal</span><strong>₹<%= order.subtotal.toLocaleString('en-IN') %></strong></p>
                        <p class="summary-line"><span>Shipping</span><strong class="free"><%= order.shippingCost === 0 ? 'FREE' : '₹' + order.shippingCost %></strong></p>
                        <p class="summary-line"><span>Tax (GST 18%)</span><strong>₹<%= order.tax.toLocaleString('en-IN') %></strong></p>
                        <p class="summary-line"><span>Discount</span><strong class="negative">-₹<%= order.discount || 0 %></strong></p>
                        <div class="summary-total"><span>Grand Total</span><strong>₹<%= order.grandTotal.toLocaleString('en-IN') %></strong></div>
                    </section>
                </aside>
            </div>
        </main>
    </div>

    <link rel="stylesheet" href="/css/notification-modal.css">
    <div class="app-notification-overlay" id="appNotification" role="dialog" aria-modal="true" aria-labelledby="appNotificationTitle" aria-describedby="appNotificationMessage">
        <div class="app-notification-modal" role="document">
            <div class="app-notification-icon" aria-hidden="true">!</div>
            <h2 class="app-notification-title" id="appNotificationTitle">Notice</h2>
            <p class="app-notification-message" id="appNotificationMessage"></p>
            <div class="app-notification-actions">
                <button class="app-notification-close" type="button">OK</button>
                <button class="app-notification-cancel" type="button">Cancel</button>
            </div>
        </div>
    </div>
    <script src="/js/notification-modal.js"></script>
    <script>
        // Live Status Update Handler (Task A.iii)
        const orderStatusSelect = document.getElementById('orderStatusSelect');
        if (orderStatusSelect) {
            orderStatusSelect.addEventListener('change', async function() {
                const newStatus = this.value;
                const previousStatus = this.dataset.currentStatus || this.querySelector('option[selected]')?.value;
                const orderId = '<%= order._id %>';

                try {
                    const res = await fetch(`/admin/orders/${orderId}/status`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: newStatus })
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.dataset.currentStatus = newStatus;
                        window.showAppModal('Order status successfully updated to ' + newStatus, 'success', {
                            onClose: () => window.location.reload()
                        });
                    } else {
                        this.value = previousStatus;
                        window.showAppModal(data.message || 'Failed to update status.', 'error');
                    }
                } catch (err) {
                    this.value = previousStatus;
                    console.error('Error updating status:', err);
                    window.showAppModal('Server error while updating status.', 'error');
                }
            });
        }
    </script>
</body>
</html>