<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Products | Fitpro Equips</title>
	<link rel="stylesheet" href="/css/admin-dashboard.css">
	<link rel="stylesheet" href="/css/product.css">
</head>
<body>
	<div class="admin-dashboard product-page">
		<%- include('../partials/admin-sidebar.ejs', { currentPage: 'products' }) %>
		<main class="main-content">
			<section class="product-heading">
				<div><p class="breadcrumb">Dashboard <span>›</span> Products</p><h1>Product Management</h1></div>
				<button class="add-product" id="openAddProduct" type="button">＋ Add Product</button>
			</section>

			<section class="product-stats" aria-label="Product summary">
				<div><span>Total<br>Products</span><strong><%= metrics && metrics.total || 0 %></strong><em class="positive">⌁</em></div>
				<div><span>Active</span><strong class="green"><%= metrics && metrics.active || 0 %></strong></div>
				<div><span>Out of Stock</span><strong class="red"><%= metrics && metrics.outOfStock || 0 %></strong></div>
				<div><span>Low Stock</span><strong class="orange"><%= metrics && metrics.lowStock || 0 %></strong></div>
				<div><span>Total<br>Inventory<br>Value</span><strong class="value">₹<%= Number(metrics && metrics.totalValue || 0).toLocaleString('en-IN') %></strong></div>
			</section>

			<section class="products-card">
				<div class="product-filters">
					<form class="product-list-search" method="GET" action="/admin/products">
						<span aria-hidden="true">⌕</span><input type="search" name="search" value="<%= searchQuery || '' %>" placeholder="Search products..." aria-label="Search products"><button type="submit" class="product-search-button">Search</button><% if (searchQuery) { %><a href="/admin/products" class="product-clear-button">Clear</a><% } %>
					</form>
					<button type="button" class="advanced-filter-button" id="openAdvancedFilters"><span>⚙</span> Advanced Filters</button>
				</div>
				<div class="table-wrap">
					<table class="products-table">
						<thead><tr><th>PRODUCT</th><th>CATEGORY</th><th>PRICE</th><th>STOCK</th><th>OFFERS</th><th>STATUS</th><th>ACTIONS</th></tr></thead>
						<tbody>
						<% if (products && products.length) { products.forEach(product => { const stock = Number(product.availableStock || 0); %>
							<tr><td class="product-name"><% if (product.images && product.images[0]) { %><img src="<%= product.images[0] %>" alt="<%= product.productName %>"><% } else { %><span class="image-placeholder">▦</span><% } %><strong><%= product.productName %></strong></td><td><%= product.categoryId && product.categoryId.name || 'Uncategorized' %></td><td class="price">₹<%= Number(product.salePrice || product.regularPrice || 0).toLocaleString('en-IN') %></td><td><span class="stock-number <%= stock < 20 ? 'low' : stock < 50 ? 'medium' : '' %>"><%= stock %></span><span class="stock-bar"><i style="width:<%= Math.min(stock, 100) %>%"></i></span></td><td><% if (product.offerPercentage) { %><span class="offer"><%= product.offerPercentage %>% OFF</span><% } else { %><span class="no-offer">No Offer</span><% } %></td><td><span class="status-pill <%= product.status === 'Active' ? 'active' : product.status === 'Low Stock' ? 'low' : 'out' %>"><%= product.status || 'Active' %></span></td><td class="actions"><button class="view-product" type="button" title="View product" aria-label="View <%= product.productName %>">&#128065;</button><button class="edit-product" type="button" title="Edit product" data-id="<%= product._id %>" data-name="<%= product.productName %>" data-category="<%= product.categoryId && product.categoryId._id || '' %>" data-price="<%= product.regularPrice || 0 %>" data-stock="<%= stock %>" data-description="<%= product.description || '' %>" data-status="<%= product.status || 'Active' %>" data-highlight-title1="<%= product.highlights && product.highlights[0] ? product.highlights[0].title : '' %>" data-highlight-title2="<%= product.highlights && product.highlights[1] ? product.highlights[1].title : '' %>" data-highlight-title3="<%= product.highlights && product.highlights[2] ? product.highlights[2].title : '' %>" data-highlight-title4="<%= product.highlights && product.highlights[3] ? product.highlights[3].title : '' %>">✎</button></td></tr>
						<% }) } else { %><tr><td colspan="7" class="empty-state">No products found.</td></tr><% } %>
						</tbody>
					</table>
				</div>
				<footer class="table-footer"><span>Showing <%= products && products.length ? ((page - 1) * limit) + 1 : 0 %> to <%= Math.min(page * limit, metrics && metrics.total || 0) %> of <%= metrics && metrics.total || 0 %> products</span><span>Rows per page: <%= limit %>⌄</span><nav><% if (page > 1) { %><a href="?page=<%= page - 1 %>">‹</a><% } %><b><%= page %></b><% if (page < totalPages) { %><a href="?page=<%= page + 1 %>">›</a><% } %></nav></footer>
			</section>
		</main>
	</div>

	<div class="product-modal hidden" id="addProductModal" role="dialog" aria-modal="true" aria-labelledby="addProductTitle">
		<div class="product-modal-panel add-modal-panel">
			<button class="modal-close" type="button" data-close-modal aria-label="Close">×</button>
			<h2 id="addProductTitle">Add New Product</h2><p class="modal-subtitle">Create a new entry in your global inventory system.</p>
			<form id="addProductForm" enctype="multipart/form-data" novalidate>
				<label for="addProductName">Product Name</label><input id="addProductName" name="productName" placeholder="e.g. Ultra Vitality Supplement" required maxlength="100"><p class="product-field-error" data-field-error="productName"></p>
				<div class="form-grid three"><div><label for="addCategory">Category</label><select id="addCategory" name="categoryId" required><option value="">Select category</option><% (categories || []).forEach(category => { %><option value="<%= category._id %>"><%= category.name %></option><% }) %></select><p class="product-field-error" data-field-error="categoryId"></p></div><div><label for="addPrice">Price</label><input id="addPrice" name="regularPrice" type="number" min="0.01" step="0.01" placeholder="₹ 0.00" required><p class="product-field-error" data-field-error="regularPrice"></p></div><div><label for="addStock">Initial Stock</label><input id="addStock" name="availableStock" type="number" min="0" step="1" placeholder="0" required><p class="product-field-error" data-field-error="availableStock"></p></div></div>
				<label for="addDescription">Description</label><textarea id="addDescription" name="description" placeholder="e.g. A daily supplement designed to support energy, immunity, and overall well-being." required maxlength="1000"></textarea><p class="product-field-error" data-field-error="description"></p>
				<fieldset class="highlight-fields"><legend>Product Highlights</legend><div class="form-grid"><% for (let index = 1; index <= 4; index++) { %><div><label for="addHighlightTitle<%= index %>">Highlight <%= index %> Title</label><input id="addHighlightTitle<%= index %>" name="highlightTitle<%= index %>" maxlength="60" required placeholder="e.g. Adjustable Weight"><p class="product-field-error" data-field-error="highlightTitle<%= index %>"></p></div><% } %></div></fieldset>
				<label>Product Image</label><label class="image-dropzone" for="addImages">▧<span>Click to upload or drag and drop</span><small>Crop to 1:1, resized to 800×800px</small><input id="addImages" name="images" type="file" accept="image/png,image/jpeg,image/gif,image/svg+xml" multiple required data-image-editor data-aspect-ratio="1" data-max-width="800"></label><p class="file-note">Select at least 3 images. Each image opens in the crop editor.</p>
				<label>Status</label><div class="status-options"><label><input type="radio" name="status" value="Active" checked><span>◉<b>ACTIVE</b></span></label><label><input type="radio" name="status" value="Out of Stock"><span>⊘<b>OUT OF STOCK</b></span></label><label><input type="radio" name="status" value="Low Stock"><span>◌<b>LOW STOCK</b></span></label></div>
				<p class="product-field-error" data-field-error="images"></p><p class="modal-error" data-form-error></p><div class="modal-actions"><button type="button" class="modal-cancel" data-close-modal>Cancel</button><button class="modal-submit" type="submit">＋ Add Product</button></div>
			</form>
		</div>
	</div>

	<div class="product-modal hidden" id="editProductModal" role="dialog" aria-modal="true" aria-labelledby="editProductTitle">
		<div class="product-modal-panel edit-modal-panel">
			<button class="modal-close" type="button" data-close-modal aria-label="Close">×</button>
			<h2 id="editProductTitle">Edit Product</h2><p class="modal-subtitle">Update the inventory details and status for your product.</p>
			<form id="editProductForm" novalidate>
				<input type="hidden" name="productId" id="editProductId"><label for="editProductName">Product Name</label><input id="editProductName" name="productName" required maxlength="100"><p class="product-field-error" data-field-error="productName"></p>
				<div class="form-grid"><div><label for="editCategory">Category</label><select id="editCategory" name="categoryId" required><option value="">Select category</option><% (categories || []).forEach(category => { %><option value="<%= category._id %>"><%= category.name %></option><% }) %></select><p class="product-field-error" data-field-error="categoryId"></p></div><div><label for="editStock">Stock</label><input id="editStock" name="availableStock" type="number" min="0" step="1" required><p class="product-field-error" data-field-error="availableStock"></p></div></div>
				<label for="editPrice">Price</label><input class="short-input" id="editPrice" name="regularPrice" type="number" min="0.01" step="0.01" required><p class="product-field-error" data-field-error="regularPrice"></p>
				<label for="editDescription">Description</label><textarea id="editDescription" name="description" required maxlength="1000"></textarea><p class="product-field-error" data-field-error="description"></p>
				<fieldset class="highlight-fields"><legend>Product Highlights</legend><div class="form-grid"><% for (let index = 1; index <= 4; index++) { %><div><label for="editHighlightTitle<%= index %>">Highlight <%= index %> Title</label><input id="editHighlightTitle<%= index %>" name="highlightTitle<%= index %>" maxlength="60" required placeholder="e.g. Adjustable Weight"><p class="product-field-error" data-field-error="highlightTitle<%= index %>"></p></div><% } %></div></fieldset>
				<label>Status</label><div class="status-options"><label><input type="radio" name="status" value="Active"><span>◉<b>ACTIVE</b></span></label><label><input type="radio" name="status" value="Out of Stock"><span>⊘<b>OUT OF STOCK</b></span></label><label><input type="radio" name="status" value="Low Stock"><span>◌<b>LOW STOCK</b></span></label></div>
				<p class="product-field-error" data-field-error="status"></p><p class="modal-error" data-form-error></p><div class="modal-actions"><button type="button" class="modal-cancel" data-close-modal>Cancel</button><button class="modal-submit" type="submit">▣ Save Changes</button></div>
			</form>
		</div>
	</div>

	<div class="product-modal hidden" id="advancedFiltersModal" role="dialog" aria-modal="true" aria-labelledby="advancedFiltersTitle">
		<div class="product-modal-panel advanced-filter-panel">
			<button class="modal-close" type="button" data-close-modal aria-label="Close">×</button>
			<h2 id="advancedFiltersTitle">Advanced Filters</h2><p class="modal-subtitle">Refine the products shown in your inventory.</p>
			<form id="advancedFiltersForm" method="GET" action="/admin/products">
				<input type="hidden" name="search" value="<%= searchQuery || '' %>">
				<label for="advancedCategories">Categories</label><select class="category-multi-select" id="advancedCategories" name="category" multiple size="5" aria-label="Select categories"><% (categories || []).forEach(category => { const selectedCategory = Array.isArray(categoryFilter) ? categoryFilter.includes(String(category._id)) : categoryFilter === String(category._id); %><option value="<%= category._id %>" <%= selectedCategory ? 'selected' : '' %>><%= category.name %></option><% }) %></select>
				<label for="advancedStatus">Status</label><select id="advancedStatus" name="status"><option value="">All statuses</option><option value="Active" <%= statusFilter === 'Active' ? 'selected' : '' %>>Active</option><option value="Low Stock" <%= statusFilter === 'Low Stock' ? 'selected' : '' %>>Low Stock</option><option value="Out of Stock" <%= statusFilter === 'Out of Stock' ? 'selected' : '' %>>Out of Stock</option></select>
				<label>Price Range</label><div class="price-range-fields"><input name="minPrice" type="number" min="0" step="0.01" value="<%= minPrice || '' %>" placeholder="Min price"><span>to</span><input name="maxPrice" type="number" min="0" step="0.01" value="<%= maxPrice || '' %>" placeholder="Max price"></div>
				<div class="modal-actions"><button type="button" class="clear-filter-button" id="clearAdvancedFilters">Clear Filters</button><span class="modal-actions-spacer"></span><button type="button" class="modal-cancel" data-close-modal>Cancel</button><button class="modal-submit" type="submit">Apply Filters</button></div>
			</form>
		</div>
	</div>
	<%- include('../partials/admin-footer.ejs') %>
	<script src="/js/image-editor.js"></script>
	<script src="/js/product.js"></script>
</body>
</html>