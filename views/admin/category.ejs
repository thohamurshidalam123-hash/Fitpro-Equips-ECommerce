<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Categories | Fitpro Equips</title>
	<link rel="stylesheet" href="/css/admin-dashboard.css">
	<link rel="stylesheet" href="/css/category.css">
</head>
<body>
	<div class="admin-dashboard">
		<%- include('../partials/admin-sidebar.ejs', { currentPage: 'categories' }) %>
		<main class="main-content category-content">
			<section class="category-heading">
				<div><h1>Category Management</h1><p>Organize and structure your store's product taxonomy.</p></div>
				<button type="button" class="primary-button" id="openAddCategory">＋ Add Category</button>
			</section>

			<section class="category-stats" aria-label="Category summary">
				<div class="category-stat"><span class="stat-symbol blue">▤</span><strong><%= totalCategories || 0 %></strong><small>TOTAL CATEGORIES</small></div>
				<div class="category-stat"><span class="stat-symbol green">✓</span><strong><%= activeCategories || 0 %></strong><small>ACTIVE</small></div>
				<div class="category-stat"><span class="stat-symbol gray">⊘</span><strong><%= inactiveCategories || 0 %></strong><small>INACTIVE</small></div>
			</section>

			<section class="category-table-card">
				<div class="table-toolbar">
					<form class="category-search" method="GET" action="/admin/category">
						<span aria-hidden="true">⌕</span>
						<input type="search" name="search" value="<%= searchQuery || '' %>" placeholder="Search categories, slugs, or IDs..." aria-label="Search categories">
						<button type="submit" class="search-button">Search</button>
						<% if (searchQuery) { %><a href="/admin/category" class="clear-button">Clear</a><% } %>
					</form>
					<span class="table-hint">Showing <%= categories ? categories.length : 0 %> rows · Newest categories first</span>
				</div>
				<div class="table-scroll">
					<table class="category-table">
						<thead><tr><th>IMAGE</th><th>CATEGORY NAME</th><th>PRODUCTS</th><th>FEATURED</th><th>OFFERS</th><th>STATUS</th><th>ACTIONS</th></tr></thead>
						<tbody>
						<% if (categories && categories.length) { %>
							<% categories.forEach(category => { %>
								<tr>
									<td><% if (category.image) { %><img class="category-image" src="<%= category.image %>" alt="<%= category.name %>"><% } else { %><div class="category-image"><%= category.name.charAt(0).toUpperCase() %></div><% } %></td>
									<td><strong><%= category.name %></strong><small><%= category.description || 'Top-level Category' %></small></td>
									<td class="product-count">0</td><td><span class="muted-pill"><%= category.featured ? 'Featured' : 'No' %></span></td><td><span class="muted-text">No Offer</span></td>
									<td><span class="status <%= category.status === 'Active' ? 'status-active' : 'status-inactive' %>"><%= category.status === 'Active' ? '● Active' : '● Inactive' %></span></td>
									<td><div class="row-actions"><button type="button" class="icon-button edit-category" title="Edit category" data-id="<%= category._id %>" data-name="<%= category.name %>" data-description="<%= category.description || '' %>" data-featured="<%= category.featured ? 'true' : 'false' %>" data-image="<%= category.image || '' %>">✎</button><button type="button" class="icon-button toggle-category" title="Toggle category status" data-id="<%= category._id %>">◉</button></div></td>
								</tr>
							<% }); %>
						<% } else { %><tr><td colspan="7" class="empty-state">No categories found.</td></tr><% } %>
						</tbody>
					</table>
				</div>
				<div class="table-footer"><span>Showing <%= categories && categories.length ? ((page - 1) * 10) + 1 : 0 %> to <%= Math.min(page * 10, totalCategories || 0) %> of <%= totalCategories || 0 %> entries</span><div class="pagination"><% if (page > 1) { %><a href="/admin/category?page=<%= page - 1 %>&search=<%= encodeURIComponent(searchQuery || '') %>">‹</a><% } %><span class="current-page"><%= page %></span><% if (page < totalPages) { %><a href="/admin/category?page=<%= page + 1 %>&search=<%= encodeURIComponent(searchQuery || '') %>">›</a><% } %></div></div>
			</section>
		</main>
	</div>

	<div class="category-modal hidden" id="categoryModal">
		<div class="category-modal-panel">
			<button class="modal-close" id="closeCategoryModal" type="button" aria-label="Close">×</button>
			<h2 id="categoryModalTitle">Add New Category</h2>
			<form id="categoryForm" enctype="multipart/form-data">
				<input type="hidden" id="categoryId">
				<label for="categoryName">Category Name</label>
				<input id="categoryName" name="name" placeholder="e.g. Yoga Mats" required maxlength="80">
				<p class="field-error" data-error-for="name"></p>
				<label for="categoryDescription">Description</label>
				<textarea id="categoryDescription" name="description" rows="3" placeholder="Describe the category..." required></textarea>
				<p class="field-error" data-error-for="description"></p>
				<div class="featured-field"><div><strong>Featured Category</strong><small>Display this category on the homepage gallery</small></div><label class="switch"><input type="checkbox" id="categoryFeatured" name="featured"><span class="slider"></span></label></div>
				<label for="categoryImage">Category Image</label>
				<label class="image-upload" for="categoryImage"><span class="upload-icon">♧</span><span>Click to upload or drag and drop</span><small>SVG, PNG, JPG OR GIF MAX (800×400PX)</small><input type="file" id="categoryImage" name="image" accept="image/png,image/jpeg,image/gif,image/svg+xml"></label>
				<div class="selected-image" id="selectedImage"></div>
				<p class="field-error" data-error-for="image"></p>
				<p class="form-error" id="categoryFormError"></p>
				<div class="modal-actions"><button type="button" class="secondary-button" id="cancelCategory">Cancel</button><button type="submit" class="primary-button">Save Category</button></div>
			</form>
		</div>
	</div>
	<%- include('../partials/admin-footer.ejs') %>
	<script src="/js/category.js"></script>
</body>
</html>
