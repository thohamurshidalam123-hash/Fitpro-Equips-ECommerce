<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Fitpro Equips</title>
    <link rel="stylesheet" href="/css/admin-dashboard.css">
    <link rel="stylesheet" href="/css/admin-scale.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Dashboard Specific Styles */
        .charts-section { margin-bottom: 24px; }
        .chart-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px; }
        .card-header h3 { margin: 0; color: #1e293b; font-size: 16px; font-weight: 600; }
        .chart-filters select { padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12px; color: #334155; background-color: #f8fafc; outline: none; cursor: pointer; }
        .chart-container { position: relative; height: 350px; width: 100%; }

        .top-lists-grid { display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; gap: 20px; margin-bottom: 30px; }
        .top-list-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); }
        .top-list { list-style: none; padding: 0; margin: 0; }
        .top-list-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px dashed #f1f5f9; }
        .top-list-item:last-child { border-bottom: none; padding-bottom: 0; }
        .item-rank { display: inline-flex; justify-content: center; align-items: center; width: 24px; height: 24px; border-radius: 50%; background: #eff6ff; color: #3b82f6; font-size: 11px; font-weight: 700; margin-right: 12px; }
        .item-rank.top-3 { background: #3b82f6; color: #fff; }
        .item-info { flex: 1; min-width: 0; }
        .item-name { display: block; color: #334155; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .item-meta { display: block; color: #64748b; font-size: 11px; margin-top: 2px; }
        .item-sales { font-weight: 700; color: #0f172a; font-size: 13px; }

    </style>
</head>
<body>
    <% 
        const totalRevenue = locals.totalRevenue ?? 0;
        const totalOrders = locals.totalOrders ?? 0;
        const pendingOrders = locals.pendingOrders ?? 0;
        const completedOrders = locals.completedOrders ?? 0;
        const totalUsers = locals.totalUsers ?? 0;
        const activeUsers = locals.activeUsers ?? 0;
        const blockedUsers = locals.blockedUsers ?? 0;
        const chartData = locals.chartData ?? {
            yearly: { labels: [], data: [] },
            monthly: { labels: [], data: [] },
            weekly: { labels: [], data: [] }
        };
        const topProducts = locals.topProducts ?? [];
        const topCategories = locals.topCategories ?? [];
        const topBrands = locals.topBrands ?? [];
    %>
    <div class="admin-dashboard">
        <!-- Sidebar Partial -->
        <%- include('../partials/admin-sidebar.ejs', { currentPage: 'dashboard' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header Partial -->
            <%- include('../partials/admin-header.ejs', { pageTitle: 'Good Morning, Admin', pageSubtitle: 'Here\'s what\'s happening with your business today' }) %>

            <!-- Stats Grid -->
            <section class="stats-grid">
                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon revenue">₹</span></div>
                    <p class="stat-label">Total Revenue</p>
                    <p class="stat-value">₹<%= totalRevenue.toLocaleString('en-IN') %></p>
                </div>

                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon orders">📦</span></div>
                    <p class="stat-label">Total Orders</p>
                    <p class="stat-value"><%= totalOrders %></p>
                </div>

                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon pending">⏳</span></div>
                    <p class="stat-label">Pending Orders</p>
                    <p class="stat-value"><%= pendingOrders %></p>
                </div>

                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon orders">✅</span></div>
                    <p class="stat-label">Completed Orders</p>
                    <p class="stat-value"><%= completedOrders %></p>
                </div>

                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon users">👥</span></div>
                    <p class="stat-label">Total Users</p>
                    <p class="stat-value"><%= totalUsers %></p>
                </div>

                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon users">👥</span></div>
                    <p class="stat-label">Total Active Users</p>
                    <p class="stat-value"><%= activeUsers %></p>
                </div>

                <div class="stat-card">
                    <div class="stat-header"><span class="stat-icon pending">🚫</span></div>
                    <p class="stat-label">Total Blocked Users</p>
                    <p class="stat-value"><%= blockedUsers %></p>
                </div>
            </section>

            <!-- Charts Section -->
            <section class="charts-section">
                <div class="chart-card revenue-card">
                    <div class="card-header">
                        <h3>Sales Analytics</h3>
                        <div class="chart-filters">
                            <select id="chartFilter" onchange="updateChartData()">
                                <option value="yearly">Yearly</option>
                                <option value="monthly" selected>Monthly (This Year)</option>
                                <option value="weekly">Weekly (Last 7 Days)</option>
                            </select>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="salesChart"></canvas>
                    </div>
                </div>
            </section>

            <!-- Top 10 Lists Section -->
            <section class="top-lists-grid">
                
                <!-- Best Selling Products -->
                <div class="top-list-card">
                    <div class="card-header">
                        <h3>Top 10 Best Selling Products</h3>
                    </div>
                    <ul class="top-list">
                        <% if (topProducts && topProducts.length > 0) { %>
                            <% topProducts.forEach((product, index) => { %>
                                <li class="top-list-item">
                                    <div style="display: flex; align-items: center; min-width: 0;">
                                        <span class="item-rank <%= index < 3 ? 'top-3' : '' %>"><%= index + 1 %></span>
                                        <div class="item-info">
                                            <span class="item-name"><%= product.productName %></span>
                                        </div>
                                    </div>
                                    <span class="item-sales"><%= product.totalQuantitySold %> sold</span>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li style="color: #64748b; font-size: 13px; text-align: center; padding: 20px 0;">No sales data yet.</li>
                        <% } %>
                    </ul>
                </div>

                <!-- Best Selling Categories -->
                <div class="top-list-card">
                    <div class="card-header">
                        <h3>Top 10 Best Selling Categories</h3>
                    </div>
                    <ul class="top-list">
                        <% if (topCategories && topCategories.length > 0) { %>
                            <% topCategories.forEach((category, index) => { %>
                                <li class="top-list-item">
                                    <div style="display: flex; align-items: center; min-width: 0;">
                                        <span class="item-rank <%= index < 3 ? 'top-3' : '' %>"><%= index + 1 %></span>
                                        <div class="item-info">
                                            <span class="item-name"><%= category.categoryName %></span>
                                        </div>
                                    </div>
                                    <span class="item-sales"><%= category.totalQuantitySold %> items</span>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li style="color: #64748b; font-size: 13px; text-align: center; padding: 20px 0;">No sales data yet.</li>
                        <% } %>
                    </ul>
                </div>

                <!-- Best Selling Brands -->
                <div class="top-list-card">
                    <div class="card-header">
                        <h3>Top 10 Best Selling Brands</h3>
                    </div>
                    <ul class="top-list">
                        <% if (topBrands && topBrands.length > 0) { %>
                            <% topBrands.forEach((brand, index) => { %>
                                <li class="top-list-item">
                                    <div style="display: flex; align-items: center; min-width: 0;">
                                        <span class="item-rank <%= index < 3 ? 'top-3' : '' %>"><%= index + 1 %></span>
                                        <div class="item-info">
                                            <span class="item-name"><%= brand.brandName %></span>
                                        </div>
                                    </div>
                                    <span class="item-sales"><%= brand.totalQuantitySold %> items</span>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li style="color: #64748b; font-size: 13px; text-align: center; padding: 20px 0;">No sales data yet.</li>
                        <% } %>
                    </ul>
                </div>

            </section>
        </main>
    </div>

    <!-- Footer Partial -->
    <%- include('../partials/admin-footer.ejs') %>

    <div id="dashboard-chart-data" data-chart="<%= JSON.stringify(chartData) %>" hidden></div>

    <!-- Chart.js Implementation -->
    <script>
        const chartData = JSON.parse(document.getElementById('dashboard-chart-data').dataset.chart);
        
        let salesChart;

        function renderChart(labels, data, label) {
            const ctx = document.getElementById('salesChart').getContext('2d');
            
            if (salesChart) {
                salesChart.destroy();
            }

            salesChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        backgroundColor: 'rgba(59, 130, 246, 0.8)', // Tailwind Blue 500
                        borderColor: 'rgba(37, 99, 235, 1)', // Tailwind Blue 600
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return '₹' + context.raw.toLocaleString('en-IN');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                callback: function(value) {
                                    if(value >= 100000) return '₹' + (value/100000) + 'L';
                                    if(value >= 1000) return '₹' + (value/1000) + 'k';
                                    return '₹' + value;
                                }
                            }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function updateChartData() {
            const filter = document.getElementById('chartFilter').value;
            let labels, data, label;

            if (filter === 'yearly') {
                labels = chartData.yearly.labels;
                data = chartData.yearly.data;
                label = 'Yearly Revenue';
            } else if (filter === 'monthly') {
                labels = chartData.monthly.labels;
                data = chartData.monthly.data;
                label = 'Monthly Revenue';
            } else if (filter === 'weekly') {
                labels = chartData.weekly.labels;
                data = chartData.weekly.data;
                label = 'Weekly Revenue';
            }

            renderChart(labels, data, label);
        }

        // Initial Render
        document.addEventListener('DOMContentLoaded', () => {
            updateChartData();
        });
    </script>
</body>
</html>