<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Fitpro Equips</title>
    <link rel="stylesheet" href="/css/landing.css">
    <link rel="stylesheet" href="/css/checkout.css">
</head>
<body>
    <div class="checkout-page-shell">

        <%- include('../partials/user-header', { currentPage: 'shop' }) %>

        <main class="checkout-main-content">
            <h1 class="checkout-page-title">Checkout</h1>

            <div class="checkout-grid">

                <!-- ================= LEFT COLUMN ================= -->
                <div class="checkout-left-col">

                    <!-- 1. Delivery Address Card -->
                    <section class="checkout-card" aria-labelledby="delivery-heading">

                        <div class="checkout-card-header">
                            <div class="card-header-left">

                                <span class="card-header-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round">

                                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                                        <circle cx="12" cy="10" r="3"/>

                                    </svg>
                                </span>

                                <h2 class="checkout-card-title" id="delivery-heading">
                                    Delivery Address
                                </h2>
                            </div>

                            <% if (activeAddress) { %>
                                <span class="address-type-pill">
                                    <%= activeAddress.addressType || 'Home' %>
                                </span>
                            <% } %>
                        </div>

                        <% if (activeAddress) { %>
                            <div class="address-details" data-active-address-id="<%= activeAddress._id %>">
                                <h3 class="address-recipient-name">
                                    <%= activeAddress.fullName %>
                                </h3>
                                <p class="address-recipient-phone">
                                    <%= activeAddress.phone %>
                                </p>
                                <p class="address-line address-line-1">
                                    <%= [activeAddress.houseName, activeAddress.street, activeAddress.landmark].filter(Boolean).join(', ') %>
                                </p>
                                <p class="address-line address-line-last">
                                    <%= activeAddress.city %>, <%= activeAddress.district %>, <%= activeAddress.state %> - <%= activeAddress.pincode %>
                                </p>

                                <div class="address-actions-row">
                                    <button type="button" class="address-action-btn" id="btnChangeAddress">
                                        Change Address
                                    </button>
                                    <button type="button" class="address-action-btn" id="btnAddNewAddress">
                                        Add New Address
                                    </button>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="address-details" data-active-address-id="">
                                <p style="color: #d52d39; margin-bottom: 15px;">
                                    No addresses found. Please add a delivery address.
                                </p>
                                <button type="button" class="address-action-btn" id="btnAddNewAddress">
                                    Add New Address
                                </button>
                            </div>
                        <% } %>
                    </section>


                    <!-- 2. Payment Method Card -->
                    <section class="checkout-card" aria-labelledby="payment-heading">
                        <div class="checkout-card-header">
                            <div class="card-header-left">
                                <h2 class="checkout-card-title" id="payment-heading">
                                    Payment Method
                                </h2>
                            </div>
                        </div>

                        <div class="payment-methods-grid">
                            <!-- Option 1: Razorpay -->
                            <div class="payment-method-item active" data-payment-method="razorpay" tabindex="0" role="button" aria-pressed="true">
                                <div class="payment-method-info">
                                    <h3 class="payment-method-name">Razorpay</h3>
                                    <p class="payment-method-sub">Google Pay, PhonePe, Cards, UPI</p>
                                </div>
                            </div>

                            <!-- Option 2: Wallet -->
                            <div class="payment-method-item" data-payment-method="wallet" tabindex="0" role="button" aria-pressed="false">
                                <div class="payment-method-info">
                                    <h3 class="payment-method-name">Wallet</h3>
                                    <p class="payment-method-sub">Pay using wallet balance</p>
                                </div>
                            </div>

                            <!-- Option 3: Cash On Delivery -->
                            <div class="payment-method-item" data-payment-method="cod" tabindex="0" role="button" aria-pressed="false">
                                <div class="payment-method-info">
                                    <h3 class="payment-method-name">Cash On Delivery</h3>
                                    <p class="payment-method-sub">Pay on delivery</p>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>

                <!-- ================= RIGHT COLUMN ================= -->
                <div class="checkout-right-col">
                    <div class="order-summary-card">
                        <h2 class="order-summary-title">Order Summary</h2>

                        <div class="summary-items-list">
                            <% cartItems.forEach(item => { %>
                                <div class="summary-item-row">
                                    <img class="summary-item-image" src="<%= item.image %>" alt="<%= item.name %>" />
                                    <div class="summary-item-info">
                                        <h3 class="summary-item-name"><%= item.name %></h3>
                                        <p class="summary-item-qty">Qty: <%= item.quantity %></p>
                                    </div>
                                    <div class="summary-item-price" style="font-weight: 600; font-size: 14px; color: #1e293b;">
                                        ₹<%= item.itemTotal.toLocaleString('en-IN') %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>

                        <hr class="summary-dotted-line"/>

                        <div class="summary-breakdown">
                            <div class="breakdown-row">
                                <span class="breakdown-label">Subtotal</span>
                                <span class="breakdown-value">₹<%= totals.subtotal.toLocaleString('en-IN') %></span>
                            </div>
                            <div class="breakdown-row shipping">
                                <span class="breakdown-label">Shipping</span>
                                <span class="breakdown-value">
                                    <%= totals.shipping === 0 ? 'FREE' : '₹' + totals.shipping.toLocaleString('en-IN') %>
                                </span>
                            </div>
                            <% if (totals.discount > 0) { %>
                                <div class="breakdown-row discount">
                                    <span class="breakdown-label">Coupon Savings<small class="applied-coupon-name"><%= appliedCoupon.name || appliedCoupon.code %></small></span>
                                    <span class="breakdown-value discount-value">
                                        -₹<%= totals.discount.toLocaleString('en-IN') %>
                                        <button type="button" class="btn-remove-coupon">Remove</button>
                                    </span>
                                </div>
                            <% } %>
                            <div class="breakdown-row">
                                <span class="breakdown-label">Tax (GST 0.18%)</span>
                                <span class="breakdown-value">₹<%= totals.tax.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                            </div>
                        </div>

                        <div class="grand-total-row">
                            <span class="grand-total-label">Grand Total</span>
                            <span class="grand-total-value">₹<%= totals.grandTotal.toLocaleString('en-IN') %></span>
                        </div>

                        <button type="button" class="btn-place-order">Place Order</button>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../partials/user-footer') %>
    </div>

    <!-- Razorpay SDK Required for payment modal -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    
    <!-- Interactive script -->
    <script src="/js/checkout.js"></script>
</body>
</html>