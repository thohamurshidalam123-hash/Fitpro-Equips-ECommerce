<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Dynamic Title -->
    <title><%= product.productName %> | Fitpro Equips</title>
    <link rel="stylesheet" href="/css/landing.css">
    <link rel="stylesheet" href="/css/product-details.css">

</head>
<body>
    <div class="page-shell product-details-page">
        <%- include('../partials/user-header', { currentPage: 'shop' }) %>

        <main>
            <div class="product-details-main">
                <!-- Dynamic Breadcrumbs -->
                <nav class="product-breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Home</a><span>›</span>
                    <a href="/shop">Shop</a><span>›</span>
                    <a href="/shop?category=<%= product.categoryId._id %>"><%= product.categoryId.name %></a><span>›</span>
                    <strong><%= product.productName %></strong>
                </nav>

                <section class="product-overview" aria-labelledby="productTitle">
                    <div class="product-gallery">
                        <!-- Main Product Image -->
                        <div class="product-gallery-main">
                            <img id="productImage" src="<%= product.images[0] %>" data-zoom-image="<%= product.images[0] %>" alt="<%= product.productName %>">
                            <div class="image-zoom-controls" aria-label="Image zoom controls">
                                <button type="button" data-zoom-out aria-label="Zoom out">−</button>
                                <button type="button" data-zoom-reset aria-label="Reset image zoom">Reset</button>
                                <button type="button" data-zoom-in aria-label="Zoom in">＋</button>
                            </div>
                        </div>
                        <span class="rotate-hint">↻ &nbsp;Use the controls to zoom</span>
                        
                        <!-- Dynamic Thumbnails -->
                        <div class="product-thumbnails" id="product-gallery" aria-label="Product images">
                            <% product.images.forEach((img, index) => { %>
                                <button type="button" class="thumbnail <%= index === 0 ? 'active' : '' %>" data-image="<%= img %>" aria-label="View image <%= index + 1 %>">
                                    <img src="<%= img %>" alt="">
                                </button>
                            <% }) %>
                        </div>
                    </div>

                    <div class="product-summary">
                        <!-- Stock Info & Error Handling -->
                        <% if (product.availableStock > 0) { %>
                            <span class="stock-label" style="color: #28a745;"><i></i> In Stock (<%= product.availableStock %> available)</span>
                        <% } else { %>
                            <span class="stock-label" style="color: #dc3545;"><i></i> Out of Stock</span>
                        <% } %>

                        <!-- Dynamic Title -->
                        <h1 id="productTitle"><%= product.productName %></h1>
                        <div class="product-rating"><span>★</span> 4.8 <a href="#description">(126 reviews)</a></div>
                        
                        <!-- Dynamic Price & Discounts -->
                        <div class="product-price-row">
                            <strong>₹<%= product.salePrice > 0 ? product.salePrice : product.regularPrice %></strong>
                            <% if (product.salePrice > 0 && product.salePrice < product.regularPrice) { %>
                                <del>₹<%= product.regularPrice %></del>
                                <span><%= Math.round(((product.regularPrice - product.salePrice) / product.regularPrice) * 100) %>% OFF</span>
                            <% } else if (product.offerPercentage > 0) { %>
                                <del>₹<%= product.regularPrice %></del>
                                <span><%= product.offerPercentage %>% OFF</span>
                            <% } %>
                        </div>

                        <!-- Product Highlights -->
                        <% if (product.highlights && product.highlights.length) { %>
                            <div class="feature-grid" aria-label="Product features">
                                <% const highlightIcons = ['⚡', '⌁', '▣', '⌂']; product.highlights.slice(0, 4).forEach((highlight, index) => { %>
                                    <div><b><%= highlightIcons[index] %></b><span><strong><%= highlight.title %></strong></span></div>
                                <% }) %>
                            </div>
                        <% } %>

                        <% if (product.variants && product.variants.length > 0) { %>
                            <fieldset class="weight-options">
                                <legend>Weight Capacity</legend>
                                <div>
                                    <% product.variants.forEach((variant, index) => { %>
                                        <button class="weight-option <%= index === 0 ? 'selected' : '' %>" type="button"><%= variant.name %></button>
                                    <% }) %>
                                </div>
                            </fieldset>
                        <% } %>

                        <!-- Purchase Row with Out of Stock Handling -->
                        <div class="purchase-row">
                            <% if (product.availableStock > 0) { %>
                                <div class="quantity-control">
                                    <button type="button" data-quantity-decrease aria-label="Decrease quantity">−</button>
                                    <output id="quantity">1</output>
                                    <button type="button" data-quantity-increase aria-label="Increase quantity">＋</button>
                                </div>
                                <button class="add-to-cart" type="button" onclick="addToCart('<%= product._id %>')">▣ &nbsp; Add to Cart</button>
                            <% } else { %>
                                <button class="add-to-cart" type="button" disabled style="background-color: #ccc; cursor: not-allowed; width: 100%;">▣ &nbsp; Out of Stock</button>
                            <% } %>
                        </div>
                        <button class="wishlist-button" type="button">♡ &nbsp; Add to Wishlist</button>
                    </div>
                </section>

                <section class="product-description" id="description">
                    <div class="section-tab">Description</div>
                    <h2>Product Overview</h2>
                    <p><%= product.description %></p>
                </section>

                <section class="product-benefits" aria-label="Shopping benefits">
                    <div><span>▣ ◫ G</span><strong>Free Delivery</strong><small>On all orders over ₹150</small></div>
                    <div><span>♧</span><strong>Secure Payment</strong><small>100% encrypted checkout</small></div>
                    <div><span>□</span><strong>Easy Returns</strong><small>30-day money-back policy</small></div>
                    <div><span>▣</span><strong>2-Year Warranty</strong><small>Premium quality guarantee</small></div>
                </section>

                <% if (relatedProducts && relatedProducts.length > 0) { %>
                    <section class="related-products" aria-labelledby="relatedProductsTitle">
                        <h2 id="relatedProductsTitle">You May Also Like</h2>
                        <p class="related-products-subtitle">Complete your home gym setup with matching strength and conditioning essentials.</p>
                        <div class="related-products-grid">
                            <% relatedProducts.forEach(rel => { %>
                                <article class="related-product-card">
                                    <% if (rel.offerPercentage > 0) { %><span class="related-sale-tag"><%= rel.offerPercentage %>% OFF</span><% } %>
                                    <button class="related-wishlist" type="button" aria-label="Add <%= rel.productName %> to wishlist">♡</button>
                                    <a class="related-product-link" href="/products/<%= rel._id %>">
                                        <div class="related-product-image"><% if (rel.images && rel.images[0]) { %><img src="<%= rel.images[0] %>" alt="<%= rel.productName %>"><% } else { %><span>FITPRO</span><% } %></div>
                                        <small><%= rel.categoryId && rel.categoryId.name ? rel.categoryId.name : product.categoryId.name %></small>
                                        <h3><%= rel.productName %></h3>
                                    </a>
                                    <strong class="related-product-price">₹<%= Number(rel.salePrice > 0 ? rel.salePrice : rel.regularPrice).toFixed(2) %></strong>
                                    <span class="related-stock-pill"><%= rel.availableStock %> in stock</span>
                                    <button class="related-cart-button" type="button">▣ Add to Cart</button>
                                </article>
                            <% }) %>
                        </div>
                    </section>
                <% } %>
            </div>
        </main>

        <%- include('../partials/user-footer') %>
    </div>

    <script>
        const productImage = document.getElementById('productImage');
        const galleryFrame = document.querySelector('.product-gallery-main');
        let imageZoom = 1;
        let imageOffsetX = 0;
        let imageOffsetY = 0;
        let isDraggingImage = false;
        let dragStartX = 0;
        let dragStartY = 0;
        let pendingOffsetX = 0;
        let pendingOffsetY = 0;
        let panFrame = 0;

        const limitImageOffset = () => {
            const maxOffsetX = Math.max((productImage.offsetWidth * imageZoom - galleryFrame.clientWidth) / 2, 0);
            const maxOffsetY = Math.max((productImage.offsetHeight * imageZoom - galleryFrame.clientHeight) / 2, 0);
            imageOffsetX = Math.max(-maxOffsetX, Math.min(imageOffsetX, maxOffsetX));
            imageOffsetY = Math.max(-maxOffsetY, Math.min(imageOffsetY, maxOffsetY));
        };

        const updateImageZoom = () => {
            limitImageOffset();
            productImage.style.transform = `translate3d(${imageOffsetX}px, ${imageOffsetY}px, 0) scale(${imageZoom})`;
            productImage.classList.toggle('is-zoomed', imageZoom > 1);
        };

        const updateImagePan = () => {
            panFrame = 0;
            imageOffsetX = pendingOffsetX;
            imageOffsetY = pendingOffsetY;
            updateImageZoom();
        };

        document.querySelector('[data-zoom-in]').addEventListener('click', () => {
            imageZoom = Math.min(imageZoom + 0.25, 2.5);
            updateImageZoom();
        });
        document.querySelector('[data-zoom-out]').addEventListener('click', () => {
            imageZoom = Math.max(imageZoom - 0.25, 1);
            updateImageZoom();
        });
        document.querySelector('[data-zoom-reset]').addEventListener('click', () => {
            imageZoom = 1;
            imageOffsetX = 0;
            imageOffsetY = 0;
            updateImageZoom();
        });

        galleryFrame.addEventListener('wheel', (event) => {
            event.preventDefault();
            imageZoom = Math.max(1, Math.min(imageZoom + (event.deltaY < 0 ? 0.15 : -0.15), 2.5));
            if (imageZoom === 1) {
                imageOffsetX = 0;
                imageOffsetY = 0;
            }
            updateImageZoom();
        }, { passive: false });

        galleryFrame.addEventListener('pointerdown', (event) => {
            if (imageZoom <= 1 || event.target !== productImage) return;
            isDraggingImage = true;
            dragStartX = event.clientX - imageOffsetX;
            dragStartY = event.clientY - imageOffsetY;
            pendingOffsetX = imageOffsetX;
            pendingOffsetY = imageOffsetY;
            productImage.setPointerCapture(event.pointerId);
            productImage.classList.add('is-dragging');
        });

        galleryFrame.addEventListener('pointermove', (event) => {
            if (!isDraggingImage) return;
            pendingOffsetX = event.clientX - dragStartX;
            pendingOffsetY = event.clientY - dragStartY;
            if (!panFrame) panFrame = requestAnimationFrame(updateImagePan);
        });

        const stopDraggingImage = () => {
            isDraggingImage = false;
            if (panFrame) {
                cancelAnimationFrame(panFrame);
                panFrame = 0;
                imageOffsetX = pendingOffsetX;
                imageOffsetY = pendingOffsetY;
                updateImageZoom();
            }
            productImage.classList.remove('is-dragging');
        };
        galleryFrame.addEventListener('pointerup', stopDraggingImage);
        galleryFrame.addEventListener('pointercancel', stopDraggingImage);

        document.querySelectorAll('.thumbnail').forEach((thumbnail) => {
            thumbnail.addEventListener('click', () => {
                productImage.src = thumbnail.dataset.image;
                imageZoom = 1;
                imageOffsetX = 0;
                imageOffsetY = 0;
                updateImageZoom();
                document.querySelectorAll('.thumbnail').forEach((item) => item.classList.remove('active'));
                thumbnail.classList.add('active');
            });
        });

        // Toggle variant selection visually
        document.querySelectorAll('.weight-option').forEach((option) => {
            option.addEventListener('click', () => {
                document.querySelectorAll('.weight-option').forEach((item) => item.classList.remove('selected'));
                option.classList.add('selected');
            });
        });

        // TASK D.v & D.vi: Increment/Decrement Quantity with Strict Stock & Max Limit Validations
        const quantity = document.getElementById('quantity');
        const availableStock = <%= product.availableStock %>;
        const maxLimitPerUser = 5; // Strict business rule limit

        // Calculate the maximum allowed quantity based on stock and arbitrary limit
        const maxAllowed = Math.min(availableStock, maxLimitPerUser);

        document.querySelector('[data-quantity-decrease]')?.addEventListener('click', () => {
            quantity.value = Math.max(Number(quantity.value) - 1, 1);
        });

        document.querySelector('[data-quantity-increase]')?.addEventListener('click', () => {
            if (Number(quantity.value) < maxAllowed) {
                quantity.value = Number(quantity.value) + 1;
            } else {
                alert(`You can only add a maximum of ${maxAllowed} units for this item.`);
            }
        });

        // Cart Submission Placeholder
        function addToCart(productId) {
            const selectedQuantity = Number(quantity.value);
            console.log(`Adding ${selectedQuantity} of product ${productId} to cart.`);

        }
    </script>
</body>
</html>