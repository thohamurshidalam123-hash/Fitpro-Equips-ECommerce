<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | Fitpro Equips</title>
    <link rel="stylesheet" href="/css/landing.css">
    <style>
        body {
            margin: 0;
            background: #eef3f8;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            color: #1a2a3a;
        }

        .forgot-page {
            max-width: 1280px;
            margin: 0 auto;
            background: #f3f5f8;
            min-height: 100vh;
        }

        .forgot-layout {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 0;
            align-items: stretch;
            min-height: 600px;
            padding: 0 0 38px;
        }

        .forgot-visual {
            position: relative;
            min-height: 520px;
            background:
                linear-gradient(rgba(15, 20, 28, 0.15), rgba(15, 20, 28, 0.15)),
                url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
            overflow: hidden;
        }

        .forgot-visual::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(16, 26, 39, 0.18), rgba(16, 26, 39, 0.02));
        }

        .forgot-copy {
            position: absolute;
            left: 44px;
            right: 52px;
            bottom: 68px;
            z-index: 1;
            color: #fff;
        }

        .forgot-copy h1 {
            margin: 0;
            font-size: clamp(34px, 3vw, 58px);
            line-height: 0.98;
            letter-spacing: -1.6px;
            font-weight: 800;
            max-width: 280px;
        }

        .forgot-copy p {
            margin-top: 18px;
            margin-bottom: 0;
            font-size: 12px;
            line-height: 1.5;
            max-width: 325px;
            color: rgba(255,255,255,0.9);
        }

        .forgot-card-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f6fa;
            padding: 40px 30px 20px;
        }

        .forgot-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border: 1px solid #edf1f7;
            border-radius: 18px;
            box-shadow: 0 14px 34px rgba(22, 32, 49, 0.08);
            padding: 30px 26px 22px;
        }

        .forgot-icon {
            width: 42px;
            height: 42px;
            margin: 0 auto 12px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 21px;
            color: #1d6fe9;
            background: #ebf3ff;
            border: 1px solid #dfeeff;
        }

        .forgot-card h2 {
            margin: 0 0 8px;
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            color: #1c2634;
        }

        .forgot-card .subtitle {
            margin: 0 0 18px;
            text-align: center;
            color: #677789;
            font-size: 13px;
            line-height: 1.5;
        }

        .forgot-card form {
            display: block;
        }

        .field-wrap {
            margin-bottom: 16px;
        }

        .field-wrap label {
            display: block;
            margin-bottom: 8px;
            font-size: 12px;
            color: #455468;
            font-weight: 600;
        }

        .field-wrap input {
            width: 100%;
            height: 42px;
            padding: 0 12px;
            border: 1px solid #dfe6f1;
            border-radius: 8px;
            background: #fff;
            font-size: 14px;
            color: #1b2330;
            outline: none;
        }

        .field-wrap input:focus {
            border-color: #1c7ef2;
            box-shadow: 0 0 0 3px rgba(28, 126, 242, 0.08);
        }

        .submit-btn {
            width: 100%;
            border: none;
            border-radius: 8px;
            height: 42px;
            background: linear-gradient(180deg, #0f6ef4, #0c61d5);
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 3px;
        }

        .submit-btn:hover {
            filter: brightness(0.97);
        }

        .auth-links {
            text-align: center;
            margin-top: 18px;
            font-size: 14px;
            color: #4f5c70;
        }

        .auth-links a {
            color: #1a6fe7;
            font-weight: 600;
            text-decoration: none;
        }

        .help-box {
            margin-top: 26px;
            text-align: center;
            color: #37475d;
        }

        .help-box .help-label {
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 12px;
            color: #1d2430;
        }

        .help-box .support-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 999px;
            border: 1px solid #dfe6f2;
            background: #ffffff;
            color: #445569;
            font-size: 12px;
            font-weight: 600;
        }

        .help-box .support-pill .mini-icon {
            display: inline-grid;
            place-items: center;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #eef5ff;
            color: #0f68ec;
            font-size: 12px;
        }

        .error-message {
            margin: 0 0 14px;
            padding: 10px 12px;
            border-radius: 8px;
            background: #fff1f1;
            border: 1px solid #f1c7c7;
            color: #a83e3e;
            font-size: 12px;
            text-align: center;
        }

        @media (max-width: 900px) {
            .forgot-layout {
                grid-template-columns: 1fr;
            }

            .forgot-visual {
                min-height: 360px;
            }

            .forgot-copy {
                left: 24px;
                right: 24px;
                bottom: 26px;
            }

            .forgot-card-wrap {
                padding-top: 12px;
            }
        }
    </style>
</head>
<body>
    <div class="forgot-page">
        <%- include('../partials/user-header') %>

        <main class="forgot-layout">
            <section class="forgot-visual" aria-label="Fitness background image">
                <div class="forgot-copy">
                    <h1>Forgot Your<br>Password?</h1>
                    <p>No worries! Enter your registered email address and we’ll send you an OTP.</p>
                </div>
            </section>

            <section class="forgot-card-wrap">
                <div class="forgot-card">
                    <div class="forgot-icon">🔒</div>
                    <h2>Reset Your Password</h2>
                    <p class="subtitle">Enter the email associated with your account.</p>

                    <% if (typeof message !== 'undefined' && message) { %>
                        <p class="error-message"><%= message %></p>
                    <% } %>

                    <form action="/forgot-password" method="POST">
                        <div class="field-wrap">
                            <label for="email">Email Address</label>
                            <input id="email" name="email" type="email" placeholder="Email Address" autocomplete="email" required>
                        </div>

                        <button class="submit-btn" type="submit">Send OTP</button>
                    </form>

                    <div class="auth-links">
                        <span>Return to <a href="/login">Login</a></span>
                    </div>

                    <div class="help-box">
                        <p class="help-label">Need Help?</p>
                        <div class="support-pill"><span class="mini-icon">✦</span> Support</div>
                    </div>
                </div>
            </section>
        </main>

        <%- include('../partials/user-footer') %>
    </div>
</body>
</html>
