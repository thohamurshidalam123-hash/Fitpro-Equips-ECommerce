<div class="profile-update-modal" id="profileUpdateModal" aria-hidden="true">
  <div class="profile-update-backdrop" data-close-profile-modal></div>
  <div class="profile-update-dialog" role="dialog" aria-modal="true" aria-labelledby="profileUpdateTitle">
    <div class="profile-update-header">
      <h2 id="profileUpdateTitle">Edit Profile</h2>
      <button type="button" class="profile-close-btn" aria-label="Close profile editor" data-close-profile-modal>&times;</button>
    </div>

    <form class="profile-update-form" id="profileUpdateForm" enctype="multipart/form-data">
      <div class="profile-update-avatar-wrap">
        <div class="profile-update-avatar" aria-label="Profile photo">
          <% if (user.profile_image) { %>
            <img src="<%= user.profile_image %>" alt="<%= user.name %> profile image">
          <% } else { %>
            <span>👤</span>
          <% } %>
        </div>
      </div>

      <div class="profile-field">
        <label for="profileImage">Profile Photo</label>
        <input id="profileImage" name="profile_image" type="file" accept="image/*">
      </div>

      <div class="profile-field">
        <label for="profileName">Username</label>
        <input id="profileName" name="name" type="text" value="<%= user.name %>" required>
      </div>

      <div class="profile-row two-col">
        <div class="profile-field">
          <label for="profileDob">Date of Birth</label>
          <input id="profileDob" name="dateOfBirth" type="date" value="<%= user.dateOfBirth ? new Date(user.dateOfBirth).toISOString().split('T')[0] : '' %>">
        </div>

        <div class="profile-field">
          <label for="profileGender">Gender</label>
          <select id="profileGender" name="gender">
            <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>
      </div>

      <div class="profile-field">
        <label for="profileEmail">Email Address</label>
        <div class="profile-inline-field">
          <input id="profileEmail" name="email" type="email" value="<%= user.email %>" required>
        </div>
      </div>

      <div class="profile-field">
        <label for="profilePhone">Phone Number</label>
        <div class="profile-inline-field">
          <span class="phone-prefix">+91</span>
          <input id="profilePhone" name="phone" type="tel" value="<%= user.phone ? user.phone.replace(/^\+91\s?/, '') : '' %>" placeholder="98765 43210">
        </div>
      </div>

      <div class="profile-actions">
        <button type="button" class="btn-link" data-close-profile-modal>Cancel</button>
        <button type="submit" class="btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<div class="profile-update-modal profile-otp-modal <%= showOtpVerification ? 'active' : '' %>" id="profileOtpModal" aria-hidden="<%= showOtpVerification ? 'false' : 'true' %>">
  <div class="profile-update-backdrop" data-close-profile-otp-modal></div>
  <div class="profile-update-dialog" role="dialog" aria-modal="true" aria-labelledby="profileOtpTitle">
    <div class="profile-update-header">
      <h2 id="profileOtpTitle">Verify Email Change</h2>
      <button type="button" class="profile-close-btn" aria-label="Close email verification" data-close-profile-otp-modal>&times;</button>
    </div>

    <form class="profile-update-form" method="POST" action="/verify-profile-otp">
      <p class="otp-message">We sent a 6-digit OTP to <strong><%= pendingEmail || user.email %></strong>. Enter it below to confirm the new email.</p>
      <% if (typeof message !== 'undefined' && message) { %>
        <p class="error-message"><%= message %></p>
      <% } %>

      <div class="profile-field">
        <label for="profileOtpCode">OTP Code</label>
        <input id="profileOtpCode" name="otp" type="text" maxlength="6" inputmode="numeric" placeholder="Enter 6-digit code" required>
      </div>

      <div class="profile-actions">
        <button type="button" class="btn-link" data-close-profile-otp-modal>Cancel</button>
        <button type="submit" class="btn-primary">Verify OTP</button>
      </div>
    </form>
  </div>
</div>
