<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fitpro Equips | Shopping Cart</title>
    <link rel="stylesheet" href="/css/landing.css">
    <style>
    :root {
        --blue: #0f67ea;
        --blue-dark: #0d5fe0;
        --navy: #0d1d33;
        --ink: #1d2b3d;
        --muted: #6e7b90;
        --line: #dfe5ee;
        --panel: #f5f7fb;
        --panel-strong: #edf3ff;
        --white: #ffffff;
        --success: #1a9c63;
        --danger: #d95555;
        --shadow: rgba(17, 37, 68, 0.08);
    }

    * { box-sizing: border-box; }
    body {
        margin: 0;
        background: #eef3fb;
        font-family: "Segoe UI", Tahoma, sans-serif;
        color: var(--ink);
    }

    a { text-decoration: none; color: inherit; }
    button { font: inherit; }

    .cart-page {
        width: min(1200px, calc(100% - 48px));
        margin: 20px auto 0;
        background: transparent;
    }

    .cart-breadcrumb {
        color: #7b8ca6;
        font-size: 12px;
        margin-bottom: 18px;
    }

    .cart-breadcrumb span { color: #9aa7b8; }

    .cart-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
    }

    .cart-header h1 {
        margin: 0;
        color: #1a2435;
        font-size: clamp(28px, 3vw, 44px);
        line-height: 1.1;
        letter-spacing: -0.06em;
    }

    .cart-header p {
        margin: 8px 0 0;
        color: #6a7a90;
        font-size: 13px;
    }

    .cart-counts {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-left: auto;
        color: #66768d;
        font-size: 12px;
        font-weight: 600;
    }

    .cart-counts strong {
        color: #1a2435;
    }

    .cart-content {
        display: grid;
        grid-template-columns: minmax(0, 2.2fr) minmax(260px, 0.8fr);
        gap: 26px;
        align-items: start;
    }

    .cart-items {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        background: rgba(255,255,255,0.75);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px 18px;
        box-shadow: 0 2px 8px var(--shadow);
        transition: opacity 0.3s ease;
    }

    /* Added dynamic styling for unavailable items */
    .cart-item.disabled-item { 
        opacity: 0.65; 
        filter: grayscale(40%); 
        background: #fff8f8; 
        border-color: var(--danger); 
    }
    .error-msg { 
        color: var(--danger); 
        font-size: 11px; 
        font-weight: bold; 
        margin-top: 5px; 
        display: block; 
    }

    .product-thumb {
        width: 150px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(180deg, #e9eef6 0%, #f4f8ff 100%);
        border-radius: 10px;
        overflow: hidden;
    }

    .product-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .product-info {
        min-width: 0;
    }

    .product-tag {
        display: inline-block;
        margin-bottom: 8px;
        padding: 4px 8px;
        border-radius: 5px;
        background: #edf4ff;
        color: #4a5d79;
        font-size: 9px;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        font-weight: 700;
    }

    .product-name {
        margin: 0 0 8px;
        font-size: clamp(18px, 2vw, 28px);
        line-height: 1.2;
        color: #1d2a3d;
        letter-spacing: -0.04em;
    }

    .product-meta {
        color: #697a90;
        font-size: 12px;
        margin: 0;
    }

    .product-meta strong {
        color: #2f3f59;
    }

    .product-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

    .qty-box {
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
        height: 34px;
    }

    .qty-box button {
        width: 30px;
        height: 100%;
        border: 0;
        background: transparent;
        color: #3e556e;
        font-size: 18px;
        cursor: pointer;
    }
    
    .qty-box button:disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }

    .qty-box .qty-value {
        min-width: 26px;
        text-align: center;
        font-weight: 700;
        color: #2d3d55;
        font-size: 14px;
    }

    .mini-link {
        color: #3d4a63;
        font-size: 12px;
        border: 0;
        background: transparent;
        padding: 0;
        cursor: pointer;
    }

    .mini-link.remove {
        color: #5f6f85;
    }

    .mini-link.wishlist {
        color: #6d7b90;
    }

    .mini-link + .mini-link { margin-left: 4px; }

    .price-block {
        text-align: right;
        min-width: 120px;
    }

    .price-block .price {
        display: block;
        font-size: 15px;
        color: #0a223f;
        font-weight: 700;
        margin: 0;
    }

    .price-block .subtotal {
        display: block;
        margin-top: 10px;
        font-size: 12px;
        color: #6a7a90;
    }

    .price-block .subtotal strong {
        color: #1f2d3d;
        font-size: 14px;
    }

    .summary-box {
        background: rgba(255,255,255,0.75);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 18px 18px 14px;
        box-shadow: 0 2px 8px var(--shadow);
    }

    .summary-title {
        margin: 0 0 14px;
        font-size: 16px;
        color: #1d2a3d;
    }

    .summary-list {
        list-style: none;
        padding: 0;
        margin: 0 0 16px;
    }

    .summary-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        color: #596a83;
        font-size: 13px;
        padding: 7px 0;
        border-bottom: 1px solid #edf1f7;
    }

    .summary-list li:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .summary-list li strong {
        color: #212f42;
        font-size: 14px;
    }

    .summary-coupon-name {
        display: block;
        margin-top: 3px;
        color: #64748b;
        font-size: 11px;
        font-weight: 400;
    }

    .summary-coupon-value {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .summary-coupon-remove {
        padding: 3px 7px;
        border: 1px solid #fecaca;
        border-radius: 4px;
        background: #fff;
        color: #b91c1c;
        font: inherit;
        font-size: 11px;
        cursor: pointer;
    }

    .summary-coupon-remove:hover { background: #fef2f2; }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 10px;
        margin-top: 8px;
        border-top: 1px solid #edf1f7;
        color: #243349;
        font-size: 15px;
        font-weight: 700;
    }

    .checkout-btn {
        width: 100%;
        margin-top: 18px;
        border: 0;
        border-radius: 9px;
        background: linear-gradient(180deg, var(--blue) 0%, var(--blue-dark) 100%);
        color: #fff;
        height: 48px;
        font-weight: 700;
        font-size: 18px;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(15,103,234,0.22);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .checkout-btn:disabled, .checkout-btn.disabled-btn {
        background: var(--muted);
        box-shadow: none;
        cursor: not-allowed;
    }

    .secure-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        color: #6d7b90;
        font-size: 11px;
        margin-top: 10px;
    }

    .secure-note::before {
        content: "\2713";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #e7f4ee;
        color: #1c9a61;
        font-size: 10px;
        font-weight: 700;
    }

    .coupon-box {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #edf1f7;
    }

    .coupon-row {
        display: flex;
        gap: 8px;
        align-items: stretch;
    }

    .coupon-row input {
        flex: 1;
        height: 34px;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0 12px;
        font-size: 13px;
        background: #fff;
        color: #2c3d58;
    }

    .coupon-row button {
        height: 34px;
        border: 0;
        border-radius: 8px;
        padding: 0 14px;
        background: #edf3ff;
        color: #2d466c;
        font-weight: 700;
        cursor: pointer;
    }

    .coupon-button {
        margin-top: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        height: 36px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
        color: #2f4266;
        font-weight: 600;
        cursor: pointer;
    }

    .coupon-button:hover {
        border-color: #b9c9e2;
        background: #f8faff;
    }

    .coupon-status {
        margin: 8px 0 0;
        color: #16804a;
        font-size: 12px;
    }

    .coupon-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1200;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(218, 230, 251, 0.78);
        backdrop-filter: blur(5px);
    }

    .coupon-modal-backdrop.active { display: flex; }

    .coupon-modal {
        display: flex;
        flex-direction: column;
        width: min(100%, 430px);
        max-height: min(680px, 90vh);
        overflow: hidden;
        border: 1px solid #dce7fc;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 16px 42px rgba(42, 75, 140, 0.17);
    }

    .coupon-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        padding: 14px 16px;
        border-bottom: 1px solid #e9eef8;
    }

    .coupon-modal-title {
        margin: 0;
        color: #172338;
        font-size: 15px;
        font-weight: 650;
    }

    .coupon-modal-close {
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #64748b;
        font-size: 21px;
        line-height: 1;
        cursor: pointer;
    }

    .coupon-modal-close:hover { background: #f1f5f9; }

    .coupon-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        overflow-y: auto;
        padding: 16px;
    }

    .coupon-list-empty {
        margin: 0;
        padding: 18px 12px;
        color: #64748b;
        font-size: 12px;
        text-align: center;
    }

    .coupon-card {
        flex-shrink: 0;
        padding: 12px;
        border: 1px solid #e8edf5;
        border-radius: 8px;
        background: #fff;
    }

    .coupon-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .coupon-code {
        display: inline-block;
        padding: 3px 7px;
        border: 1px solid #d8e5ff;
        border-radius: 4px;
        background: #f3f7ff;
        color: #0752c9;
        font-size: 10px;
        font-weight: 600;
    }

    .coupon-name {
        margin: 5px 0 0;
        color: #1e293b;
        font-size: 11px;
        font-weight: 500;
    }

    .coupon-apply-button,
    .coupon-expired-label {
        flex-shrink: 0;
        min-width: 52px;
        padding: 6px 9px;
        border: 1px solid #0f67ea;
        border-radius: 5px;
        background: #fff;
        color: #0f67ea;
        font: inherit;
        font-size: 10px;
        font-weight: 600;
        text-align: center;
    }

    .coupon-apply-button { cursor: pointer; }
    .coupon-apply-button:hover { background: #0752c9; color: #fff; }

    .coupon-discount {
        margin: 4px 0 10px;
        color: #0752c9;
        font-size: 14px;
        font-weight: 700;
    }

    .coupon-discount.is-green { color: #07833d; }

    .coupon-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 5px 12px;
        padding-top: 8px;
        border-top: 1px solid #edf1f7;
        color: #64748b;
        font-size: 10px;
    }

    .coupon-card.is-expired {
        background: #fbfcfe;
        opacity: 0.58;
    }

    .coupon-card.is-expired .coupon-code {
        border-color: #e2e8f0;
        background: #f1f5f9;
        color: #64748b;
        text-decoration: line-through;
    }

    .coupon-expired-label {
        border-color: transparent;
        background: #edf2fa;
        color: #64748b;
        font-weight: 500;
    }

    .coupon-card.is-expired .coupon-discount,
    .coupon-card.is-expired .coupon-meta { color: #64748b; }

    .coupon-manual-entry {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-shrink: 0;
        margin-top: auto;
        padding: 12px;
        border-top: 1px solid #e9eef8;
        background: #f8faff;
    }

    .coupon-manual-icon {
        color: #475569;
        font-size: 20px;
        line-height: 1;
    }

    .coupon-manual-entry input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #1d2b3d;
        font: inherit;
        font-size: 11px;
    }

    .coupon-manual-entry input::placeholder { color: #7b8799; }
    .coupon-manual-entry:focus-within { box-shadow: inset 0 0 0 1px #bfdbfe; }

    .coupon-manual-check {
        border: 0;
        background: transparent;
        color: #0f67ea;
        font: inherit;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

    .delivery-box {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid #edf1f7;
    }

    .delivery-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        color: #51617b;
        font-size: 12px;
        font-weight: 600;
    }

    .delivery-row .address-btn {
        border: 0;
        background: transparent;
        color: var(--blue);
        font-weight: 700;
        cursor: pointer;
        padding: 0;
    }

    .delivery-address {
        margin-top: 12px;
        display: flex;
        gap: 8px;
        color: #334d6e;
        font-size: 12px;
        line-height: 1.5;
    }

    .delivery-address .pin {
        color: #7d8ea7;
        font-size: 16px;
        line-height: 1;
        margin-top: 2px;
    }

    .cart-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        margin-top: 18px;
    }

    .cart-pagination a,
    .cart-pagination span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        height: 30px;
        padding: 0 9px;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: #52647d;
        background: #fff;
        font-size: 12px;
    }

    .cart-pagination a.current {
        color: #fff;
        border-color: var(--blue);
        background: var(--blue);
    }

    .cart-pagination span.disabled {
        color: #adb8c8;
        background: #f5f7fb;
    }

    @media (max-width: 980px) {
        .cart-content { grid-template-columns: 1fr; }
        .summary-box { order: -1; }
    }

    @media (max-width: 640px) {
        .cart-page { width: min(100% - 20px, 900px); }
        .cart-header { flex-wrap: wrap; align-items: flex-start; }
        .cart-counts { width: 100%; justify-content: flex-start; margin-left: 0; margin-top: 8px; }
        .cart-item { grid-template-columns: 1fr; text-align: left; }
        .product-thumb { width: 100%; height: 200px; }
        .price-block { text-align: left; }
    }
</style>

<body>
    <div class="page-shell cart-shell">
        <%- include('../partials/user-header', { currentPage: 'cart' }) %>

        <main>
            <div class="cart-page">
                <div class="cart-breadcrumb">Home <span>›</span> Shopping Cart</div>

                <div class="cart-header">
                    <div>
                        <h1>Shopping Cart</h1>
                        <p>Review your selected fitness equipment before checkout</p>
                    </div>
                    <div class="cart-counts">
                        <!-- Dynamic Item Count -->
                        <span><strong><%= itemCount || 0 %> items</strong></span>
                        <span>Estimated Delivery: 3-5 Business Days</span>
                    </div>
                </div>

                <div class="cart-content">
                    <div class="cart-items">
                        <!-- DYNAMIC CART LOOP -->
                        <% if (typeof cartItems !== 'undefined' && cartItems.length > 0) { %>
                            <% cartPageItems.forEach(item => { %>
                                <!-- Task D.vii: Add class if item is disabled or out of stock -->
                                <article class="cart-item <%= (!item.isAvailable || item.outOfStock) ? 'disabled-item' : '' %>">
                                    <div class="product-thumb">
                                        <a href="/products/<%= item.productId._id %>">
                                            <img src="<%= item.variant && item.variant.images && item.variant.images[0] ? item.variant.images[0] : item.productId.images[0] %>" alt="<%= item.productId.productName %>">
                                        </a>
                                    </div>
                                    <div class="product-info">
                                        <span class="product-tag"><%= item.productId.brandId ? item.productId.brandId.name : (item.productId.categoryId ? item.productId.categoryId.name : 'Equipment') %></span>
                                        <a href="/products/<%= item.productId._id %>">
                                            <h2 class="product-name"><%= item.productId.productName %></h2>
                                        </a>
                                        
                                        <p class="product-meta"><strong>Brand:</strong> <%= item.productId.brandId ? item.productId.brandId.name : 'Fitpro Equipment' %><% if (item.variant) { %> <span>·</span> <strong>Variant:</strong> <%= item.variant.name || `${item.variant.weight} ${item.variant.weightUnit || 'kg'}` %><% if (item.variant.color) { %> (<%= item.variant.color %>)<% } %><% } %></p>

                                        <!-- Task D.vii: Error Warnings for blocked/OOS items -->
                                        <% if (!item.isAvailable) { %>
                                            <span class="error-msg">⚠️ This item is currently unlisted and cannot be purchased.</span>
                                        <% } else if (item.outOfStock) { %>
                                            <span class="error-msg">🚫 Out of Stock</span>
                                        <% } else if (!item.hasStock) { %>
                                            <span class="error-msg">⚠️ Only <%= item.variant ? item.variant.stock : item.productId.availableStock %> units left. Reduce quantity.</span>
                                        <% } %>

                                        <div class="product-controls">
                                            <div class="qty-box" aria-label="Quantity selector">
                                                <button type="button" onclick="updateQty('<%= item._id %>', 'decrease')" <%= (!item.isAvailable || item.outOfStock) ? 'disabled' : '' %> aria-label="Decrease quantity">−</button>
                                                <span class="qty-value"><%= item.quantity %></span>
                                                <button type="button" onclick="updateQty('<%= item._id %>', 'increase')" <%= (!item.isAvailable || item.outOfStock) ? 'disabled' : '' %> aria-label="Increase quantity">+</button>
                                            </div>
                                            <button class="mini-link remove" type="button" onclick="removeItem('<%= item._id %>')">Remove</button>
                                            <button class="mini-link wishlist" type="button" data-item-id="<%= item._id %>" data-product-id="<%= item.productId._id %>" data-variant-id="<%= item.variantId || '' %>">Add to Wishlist</button>
                                        </div>
                                    </div>
                                    <div class="price-block">
                                        <p class="price">₹<%= item.price.toLocaleString('en-IN') %></p>
                                        <span class="subtotal">Subtotal <strong>₹<%= item.totalPrice.toLocaleString('en-IN') %></strong></span>
                                    </div>
                                </article>
                            <% }) %>
                        <% } else { %>
                            <div style="text-align: center; padding: 40px; background: rgba(255,255,255,0.75); border-radius: 12px; border: 1px solid var(--line);">
                                <h2>Your cart is empty</h2>
                                <p style="color: var(--muted); margin-bottom: 20px;">Looks like you haven't added any fitness gear yet.</p>
                                <a href="/shop" class="checkout-btn" style="display: inline-flex; width: auto; padding: 0 30px;">Continue Shopping</a>
                            </div>
                        <% } %>
                        <% if (totalPages > 1) { %>
                            <nav class="cart-pagination" aria-label="Cart pages">
                                <% if (page > 1) { %><a href="/cart?page=<%= page - 1 %>">Previous</a><% } else { %><span class="disabled" aria-disabled="true">Previous</span><% } %>
                                <% for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) { %><a href="/cart?page=<%= pageNumber %>" class="<%= pageNumber === page ? 'current' : '' %>"><%= pageNumber %></a><% } %>
                                <% if (page < totalPages) { %><a href="/cart?page=<%= page + 1 %>">Next</a><% } else { %><span class="disabled" aria-disabled="true">Next</span><% } %>
                            </nav>
                        <% } %>
                    </div>

                    <aside class="summary-box">
                        <h3 class="summary-title">Order Summary</h3>
                        <ul class="summary-list">
                            <li><span>Subtotal (<%= itemCount || 0 %> items)</span><strong>₹<%= (typeof subtotal !== 'undefined' ? subtotal : 0).toLocaleString('en-IN') %></strong></li>
                            <li>
                                <span>Coupon Savings<% if (appliedCoupon && discount > 0) { %><small class="summary-coupon-name"><%= appliedCoupon.name || appliedCoupon.code %></small><% } %></span>
                                <strong class="summary-coupon-value">
                                    - ₹<%= (discount || 0).toLocaleString('en-IN') %>
                                    <% if (appliedCoupon && discount > 0) { %><button class="summary-coupon-remove" id="btnRemoveCartCoupon" type="button">Remove</button><% } %>
                                </strong>
                            </li>
                            <li><span>Estimated Shipping</span><strong>₹<%= (typeof shipping !== 'undefined' ? shipping : 0).toLocaleString('en-IN') %></strong></li>
                            <li><span>Tax (GST 0.18%)</span><strong>₹<%= (typeof tax !== 'undefined' ? tax : 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></li>
                        </ul>
                        <div class="summary-total">
                            <span>Total</span>
                            <span>₹<%= (typeof total !== 'undefined' ? total : 0).toLocaleString('en-IN') %></span>
                        </div>

                        <!-- Task D.vii: Restrict Checkout dynamically -->
                        <% if (typeof canCheckout !== 'undefined' && canCheckout && itemCount > 0) { %>
                            <a href="/checkout" class="checkout-btn">Proceed to Checkout</a>
                        <% } else { %>
                            <button class="checkout-btn disabled-btn" type="button" disabled>
                                <%= itemCount === 0 ? 'Cart is Empty' : 'Fix Cart Errors to Checkout' %>
                            </button>
                        <% } %>
                        
                        <div class="secure-note">Secure encrypted checkout</div>

                        <div class="coupon-box">
                            <div class="coupon-row">
                                <input id="cartCouponCode" type="text" placeholder="Enter code" aria-label="Coupon code" />
                                <button id="btnApplyCartCoupon" type="button">Apply</button>
                            </div>
                            <button class="coupon-button" id="btnOpenCouponList" type="button">Coupon List</button>
                            <p class="coupon-status" id="cartCouponStatus" aria-live="polite" hidden></p>
                        </div>
                    </aside>
                </div>
            </div>
        </main>

        <div class="coupon-modal-backdrop" id="cartCouponModal" aria-hidden="true">
            <section class="coupon-modal" role="dialog" aria-modal="true" aria-labelledby="cartCouponModalTitle">
                <header class="coupon-modal-header">
                    <h2 class="coupon-modal-title" id="cartCouponModalTitle">Available Coupons</h2>
                    <button type="button" class="coupon-modal-close" data-close-coupon-modal aria-label="Close coupons">&times;</button>
                </header>

                <div class="coupon-list">
                    <% if (availableCoupons.length) { %>
                        <% availableCoupons.forEach(coupon => { %>
                            <article class="coupon-card">
                                <div class="coupon-card-top">
                                    <div>
                                        <span class="coupon-code"><%= coupon.couponCode %></span>
                                        <p class="coupon-name"><%= coupon.couponName %></p>
                                    </div>
                                    <button type="button" class="coupon-apply-button" data-cart-coupon-code="<%= coupon.couponCode %>">Apply</button>
                                </div>
                                <p class="coupon-discount <%= coupon.discountType === 'fixed' ? 'is-green' : '' %>"><%= coupon.discountType === 'percentage' ? `${coupon.discountValue}% Off` : `₹${Number(coupon.discountValue).toLocaleString('en-IN')} Flat Off` %></p>
                                <div class="coupon-meta"><span>Min: ₹<%= Number(coupon.minPurchaseAmount).toLocaleString('en-IN') %></span><span>Ends <%= new Date(coupon.expiryDate).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) %></span></div>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <p class="coupon-list-empty">No active coupons are available right now.</p>
                    <% } %>
                </div>

                <form class="coupon-manual-entry" id="cartManualCouponForm">
                    <label class="coupon-manual-icon" for="cartManualCouponCode" aria-hidden="true">◇</label>
                    <input id="cartManualCouponCode" type="text" placeholder="Enter coupon code manually" autocomplete="off" required>
                    <button type="submit" class="coupon-manual-check">Check</button>
                </form>
            </section>
        </div>

        <%- include('../partials/user-footer') %>
    </div>

    <script>
    // Task D.v & D.vi: Increment/Decrement via AJAX
    async function updateQty(itemId, action) {
        try {
            const response = await fetch('/cart/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ itemId, action })
            });
            const data = await response.json();
            
            if (data.success) {
                // Reloads the page to cleanly recalculate the backend totals and tax
                window.location.reload(); 
            } else {
                if (typeof window.showAppModal === 'function') {
                    window.showAppModal(data.message || 'Cart update failed.', 'error');
                }
            }
        } catch (error) {
            console.error('Error:', error);
            if (typeof window.showAppModal === 'function') {
                window.showAppModal('Something went wrong while updating the cart.', 'error');
            }
        }
    }

    // Task D.i: Remove Item
    async function removeItem(itemId) {
        if (typeof window.showConfirmationModal === 'function') {
            window.showConfirmationModal('Are you sure you want to remove this item?', () => removeItemRequest(itemId));
            return;
        }

        removeItemRequest(itemId);
    }

    async function removeItemRequest(itemId) {
        try {
            const response = await fetch('/cart/remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ itemId })
            });
            if ((await response.json()).success) window.location.reload();
        } catch (error) {
            console.error('Error:', error);
            if (typeof window.showAppModal === 'function') {
                window.showAppModal('Something went wrong while removing the item.', 'error');
            }
        }
    }

    // For moving item into Wishlist
    async function moveToWishlist(itemId, productId, variantId) {
        try {
            const response = await fetch('/cart/moveToWishlist', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ itemId, productId, variantId })
            });
            const data = await response.json();
            if (data.success) {
                if (typeof window.showAppModal === 'function') {
                    window.showAppModal(data.message || 'Item moved to wishlist.', 'success', {
                        showCancel: true,
                        onClose: () => window.location.reload()
                    });
                } else {
                    window.location.reload();
                }
            } else if (typeof window.showAppModal === 'function') {
                window.showAppModal(data.message || 'Unable to move item to wishlist.', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            if (typeof window.showAppModal === 'function') {
                window.showAppModal('Something went wrong while moving the item.', 'error');
            }
        }
    }

    document.querySelectorAll('.mini-link.wishlist').forEach(button => {
        button.addEventListener('click', () => {
            moveToWishlist(button.dataset.itemId, button.dataset.productId, button.dataset.variantId);
        });
    });

    const couponModal = document.getElementById('cartCouponModal');
    const openCouponListButton = document.getElementById('btnOpenCouponList');
    const cartCouponCode = document.getElementById('cartCouponCode');
    const cartCouponStatus = document.getElementById('cartCouponStatus');
    let couponModalPreviousFocus = null;
    let previousBodyOverflow = '';

    function closeCouponModal() {
        couponModal.classList.remove('active');
        couponModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = previousBodyOverflow;
        couponModalPreviousFocus?.focus();
    }

    function selectCartCoupon(code) {
        const normalizedCode = String(code || '').trim().toUpperCase();
        if (!normalizedCode) {
            window.showAppModal('Please enter a coupon code.', 'error');
            return;
        }

        cartCouponCode.value = normalizedCode;
        cartCouponStatus.hidden = true;
        closeCouponModal();
        applyCartCoupon(normalizedCode);
    }

    async function applyCartCoupon(code) {
        const applyButton = document.getElementById('btnApplyCartCoupon');
        const originalButtonText = applyButton.textContent;
        applyButton.disabled = true;
        applyButton.textContent = 'Applying...';

        try {
            const response = await fetch('/apply-coupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ couponCode: code })
            });
            const data = await response.json();

            if (!response.ok || !data.success) {
                window.showAppModal(data.message || 'Unable to apply this coupon.', 'error');
                return;
            }

            cartCouponStatus.textContent = `Coupon ${data.couponCode || code} applied successfully.`;
            cartCouponStatus.hidden = false;
            window.showAppModal(data.message || 'Coupon applied successfully.', 'success', {
                onClose: () => window.location.reload()
            });
        } catch (error) {
            console.error('Error applying coupon:', error);
            window.showAppModal('Unable to apply this coupon. Please try again.', 'error');
        } finally {
            applyButton.disabled = false;
            applyButton.textContent = originalButtonText;
        }
    }

    const removeCartCouponButton = document.getElementById('btnRemoveCartCoupon');
    if (removeCartCouponButton) {
        removeCartCouponButton.addEventListener('click', async () => {
            removeCartCouponButton.disabled = true;
            try {
                const response = await fetch('/remove-coupon', { method: 'POST' });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    window.showAppModal(data.message || 'Unable to remove the coupon.', 'error');
                    removeCartCouponButton.disabled = false;
                    return;
                }
                window.showAppModal(data.message || 'Coupon removed successfully.', 'success', {
                    onClose: () => window.location.reload()
                });
            } catch (error) {
                console.error('Error removing coupon:', error);
                window.showAppModal('Unable to remove the coupon. Please try again.', 'error');
                removeCartCouponButton.disabled = false;
            }
        });
    }

    openCouponListButton.addEventListener('click', () => {
        couponModalPreviousFocus = document.activeElement;
        previousBodyOverflow = document.body.style.overflow;
        couponModal.classList.add('active');
        couponModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        couponModal.querySelector('[data-close-coupon-modal]').focus();
    });

    couponModal.querySelector('[data-close-coupon-modal]').addEventListener('click', closeCouponModal);
    couponModal.addEventListener('click', event => {
        if (event.target === couponModal) closeCouponModal();
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && couponModal.classList.contains('active')) closeCouponModal();
    });

    couponModal.querySelectorAll('[data-cart-coupon-code]').forEach(button => {
        button.addEventListener('click', () => selectCartCoupon(button.dataset.cartCouponCode));
    });

    document.getElementById('cartManualCouponForm').addEventListener('submit', event => {
        event.preventDefault();
        const code = document.getElementById('cartManualCouponCode').value.trim().toUpperCase();
        selectCartCoupon(code);
    });

    document.getElementById('btnApplyCartCoupon').addEventListener('click', () => {
        selectCartCoupon(cartCouponCode.value.trim().toUpperCase());
    });
</script>
</body>
</html>