<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Fitpro Equips</title>
    <link rel="stylesheet" href="/css/landing.css">
    <style>
        :root {
            --blue: #0f6fe8;
            --blue-soft: #eaf3ff;
            --border: #dfeaf8;
            --text: #1c2530;
            --muted: #647386;
            --navy: #0b1d2d;
            --page-bg: #edf2f7;
            --light-card: #f6f8fb;
        }

        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            background: var(--page-bg);
            font-family: "Segoe UI", Tahoma, sans-serif;
            color: var(--text);
        }

        body {
            min-height: 100vh;
        }

        a { color: inherit; text-decoration: none; }
        button, input {
            font: inherit;
        }

        .page-shell {
            max-width: 1280px;
            margin: 0 auto;
            background: #f2f5f8;
        }

        .site-header {
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px 0 20px;
            background: #fff;
            border-bottom: 1px solid #e7ebf2;
            border-top: 1px solid #0f1f2f;
        }

        .brand {
            color: #0f6fe8;
            font-size: 19px;
            font-weight: 700;
            letter-spacing: -0.4px;
        }

        .main-nav {
            display: flex;
            align-items: center;
            gap: 26px;
            font-size: 12px;
            color: #3d4656;
        }

        .main-nav a {
            position: relative;
            color: #2d3748;
        }

        .main-nav a.active {
            color: #0f6fe8;
        }

        .main-nav a.active::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -8px;
            height: 2px;
            background: var(--blue);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            color: #39475e;
        }

        .icon {
            display: inline-block;
            width: 14px;
            height: 14px;
            position: relative;
        }

        .search-icon {
            border: 1.5px solid currentColor;
            border-radius: 50%;
        }

        .search-icon::after {
            content: "";
            position: absolute;
            width: 6px;
            height: 1.5px;
            background: currentColor;
            right: -4px;
            bottom: -2px;
            transform: rotate(45deg);
            border-radius: 2px;
        }

        .heart-icon::before {
            content: "♡";
            position: absolute;
            inset: 0;
            font-size: 14px;
            line-height: 14px;
            text-align: center;
        }

        .cart-icon {
            border: 1.5px solid currentColor;
            border-top: 0;
            border-radius: 2px;
        }

        .cart-icon::before,
        .cart-icon::after {
            content: "";
            position: absolute;
            width: 4px;
            height: 4px;
            border: 1.2px solid currentColor;
            border-radius: 50%;
            bottom: -4px;
            background: transparent;
        }

        .cart-icon::before { left: 1px; }
        .cart-icon::after { right: 1px; }

        .user-icon {
            width: 14px;
            height: 14px;
            border: 1.5px solid currentColor;
            border-radius: 50%;
        }

        .user-icon::before {
            content: "";
            position: absolute;
            left: 4px;
            right: 4px;
            bottom: -1px;
            height: 5px;
            border: 1.2px solid currentColor;
            border-top: 0;
            border-radius: 0 0 7px 7px;
        }

        .reset-layout {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            min-height: 560px;
            background: #f3f5f7;
        }

        .reset-image {
            position: relative;
            min-height: 520px;
            background:
                linear-gradient(90deg, rgba(10, 17, 25, 0.08), rgba(10, 17, 25, 0.02)),
                url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
        }

        .reset-page-copy {
            position: absolute;
            left: 42px;
            bottom: 36px;
            z-index: 1;
            color: #fff;
            max-width: 370px;
        }

        .reset-page-copy h1 {
            margin: 0;
            font-size: 56px;
            line-height: 0.95;
            font-weight: 800;
            letter-spacing: -2px;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.14);
        }

        .reset-page-copy p {
            margin: 18px 0 0;
            font-size: 12px;
            line-height: 1.5;
            color: rgba(255,255,255,0.9);
        }

        .reset-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px 10px;
            background: #f3f5f8;
        }

        .reset-card {
            width: 100%;
            max-width: 420px;
            padding: 24px 24px 18px;
            background: #fff;
            border: 1px solid #e0ebff;
            border-radius: 14px;
            box-shadow: 0 10px 22px rgba(18, 37, 61, 0.04);
        }

        .reset-card h2 {
            margin: 0 0 8px;
            text-align: center;
            font-size: 22px;
            line-height: 1.2;
            font-weight: 700;
            color: #1e2e3d;
        }

        .reset-card .subtitle {
            margin: 0 0 20px;
            text-align: center;
            color: #69788d;
            font-size: 12px;
            line-height: 1.5;
        }

        .field-group {
            margin-bottom: 14px;
        }

        .field-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 12px;
            color: #434f60;
            font-weight: 600;
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap input {
            width: 100%;
            height: 38px;
            padding: 0 36px 0 12px;
            border: 1px solid #dfeaf5;
            border-radius: 8px;
            background: #fff;
            color: #1f2a37;
            font-size: 13px;
            outline: none;
        }

        .input-wrap input:focus {
            border-color: #5aa0ff;
            box-shadow: 0 0 0 3px rgba(92, 164, 255, 0.12);
        }

        .field-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #7d8ea6;
            font-size: 14px;
            line-height: 1;
        }

        .resend-link {
            display: inline-block;
            margin: -4px 0 10px;
            color: #0f6fe8;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }

        .primary-btn {
            width: 100%;
            border: none;
            border-radius: 8px;
            height: 40px;
            background: linear-gradient(180deg, #0f6fe8, #0c5edb);
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
        }

        .back-link {
            display: block;
            margin-top: 14px;
            text-align: center;
            font-size: 12px;
            color: #1a6fe8;
            font-weight: 600;
        }

        .footer {
            background: var(--navy);
            color: #dfe8f2;
            padding: 34px 56px 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr 1fr 1fr;
            gap: 22px;
            align-items: start;
        }

        .footer-brand h3 {
            margin: 0 0 10px;
            font-size: 18px;
            color: #fff;
            font-weight: 700;
        }

        .footer-brand p {
            margin: 0;
            font-size: 12px;
            line-height: 1.6;
            color: #bcc9d9;
            max-width: 220px;
        }

        .footer-col h4 {
            margin: 0 0 12px;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
        }

        .footer-col a {
            display: block;
            margin: 0 0 8px;
            color: #c4d0e1;
            font-size: 12px;
            line-height: 1.5;
        }

        .copyright {
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            color: #a5b3c3;
            font-size: 11px;
        }

        @media (max-width: 900px) {
            .reset-layout {
                grid-template-columns: 1fr;
            }
            .reset-image {
                min-height: 360px;
            }
            .reset-page-copy {
                left: 26px;
                bottom: 26px;
            }
            .footer-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 560px) {
            .site-header {
                padding: 0 16px;
            }
            .main-nav {
                gap: 10px;
                font-size: 10px;
            }
            .reset-card {
                padding: 18px 16px 16px;
            }
            .reset-page-copy h1 {
                font-size: 40px;
            }
            .footer {
                padding: 28px 22px 18px;
            }
            .footer-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <%- include('../partials/user-header') %>

        <main class="reset-layout">
            <section class="reset-image" aria-label="Fitness background image">
                <div class="reset-page-copy">
                    <h1>Forgot Your<br>Password?</h1>
                    <p>No worries! Enter your registered email address and we’ll send you a password reset link.</p>
                </div>
            </section>

            <section class="reset-panel">
                <div class="reset-card">
                    <h2>Create New<br>Password</h2>
                    <p class="subtitle">Please enter the OTP sent to your email and set your new password.</p>

                    <form action="/reset-password" method="POST">
                        <div class="field-group">
                            <label for="otp">OTP Verification</label>
                            <div class="input-wrap">
                                <input id="otp" name="otp" type="text" maxlength="6" placeholder="Enter 6-digit code" required>
                            </div>
                            <a onclick="resentOtp()" class="resend-link">Resend OTP</a>
                        </div>

                        <div class="field-group">
                            <label for="newPassword">New Password</label>
                            <div class="input-wrap">
                                <input id="newPassword" name="newPassword" type="password" placeholder="New Password" required>
                                <span class="field-icon">◌</span>
                            </div>
                        </div>

                        <div class="field-group">
                            <label for="confirmPassword">Confirm New Password</label>
                            <div class="input-wrap">
                                <input id="confirmPassword" name="confirmPassword" type="password" placeholder="Confirm New Password" required>
                                <span class="field-icon">◌</span>
                            </div>
                        </div>

                        <button class="primary-btn" type="submit">Reset Password</button>
                    </form>

                    <a href="/login" class="back-link">← Back to Sign In</a>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div class="footer-grid">
                <div class="footer-brand">
                    <h3>Fitpro Equips</h3>
                    <p>Empowering your fitness journey with high-performance gear designed for excellence.</p>
                </div>

                <div class="footer-col">
                    <h4>Quick Links</h4>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                    <a href="#">Shipping &amp; Returns</a>
                    <a href="#">Contact Us</a>
                </div>

                <div class="footer-col">
                    <h4>Shop</h4>
                    <a href="#">Dumbbells</a>
                    <a href="#">Olympic Bars</a>
                    <a href="#">Rowing Machines</a>
                    <a href="#">Squat Racks</a>
                </div>

                <div class="footer-col">
                    <h4>Help</h4>
                    <a href="#">FAQs</a>
                    <a href="#">Assembly Guides</a>
                    <a href="#">Financing Options</a>
                    <a href="#">Warranty Claim</a>
                </div>
            </div>

            <div class="copyright">© 2026 Fitpro Equips. All rights reserved.</div>
        </footer>
    </div>
</body>
<script>
    const resentOtp = () => {
        
    }
</script>
</html>
