<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Fitpro Equips | Build Your Strongest Self</title>
	<link rel="stylesheet" href="/css/landing.css">
</head>
<body>
	<div class="page-shell">
		<%- include('../partials/user-header') %>
		<main>
			<section class="hero">
				<div class="hero-copy"><h1>Build Your <strong>Strongest</strong> Self</h1><p>Premium fitness equipment designed to help you perform. Whether you're setting up a home gym or upgrading to a pro facility, we have the gear to push your limits.</p><div class="hero-actions"><a class="button" href="/shop">Shop Now</a></div></div>
				<div class="hero-image" role="img" aria-label="Dumbbells in a bright modern gym"></div>
			</section>
			<section class="section" id="categories"><h2 class="section-heading">Shop by Category</h2><p class="section-subtitle">Find the perfect tools for your training methodology</p><div class="category-grid">
				<% categories.forEach((category, index) => { %>
					<a class="category <%= ['dumbbells', 'barbells', 'cardio', 'benches', 'bands', 'accessories'][index % 6] %>" href="/shop?category=<%= category._id %>"<% if (category.image) { %> style="background-image: url('<%= category.image %>')"<% } %>><span class="category-content"><h3><%= category.name %></h3></span></a>
				<% }) %>
			</div></section>
			<section class="section benefits" id="about"><div class="benefit"><span class="benefit-icon">◉</span><h3>Premium Quality</h3><p>Built to last with high-quality materials and rigorous testing.</p></div><div class="benefit"><span class="benefit-icon">▣</span><h3>Fast Delivery</h3><p>Efficient shipping across India with tracking updates.</p></div><div class="benefit"><span class="benefit-icon">◆</span><h3>Secure Payment</h3><p>Your transactions are protected every step of the way.</p></div><div class="benefit"><span class="benefit-icon">×</span><h3>Warranty Support</h3><p>Comprehensive coverage and expert service when you need it.</p></div></section>
		</main>
		<%- include('../partials/user-footer') %>
	</div>
	<script src="/js/landing.js"></script>
</body>
</html>
