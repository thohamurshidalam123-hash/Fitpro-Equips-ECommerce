<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Fitpro Equips | Shop</title>
	<link rel="stylesheet" href="/css/landing.css">
	<link rel="stylesheet" href="/css/shop.css">
</head>
<body>
	<div class="page-shell shop-shell">
		<%- include('../partials/user-header', { currentPage: 'shop' }) %>
		<main class="shop-main">
			<div class="shop-breadcrumb"><a href="/">Home</a><span>›</span><strong>Shop</strong></div>
			<section class="shop-heading">
				<div><h1>Shop Fitness Equipment</h1><p>Browse premium gym equipment for every fitness goal.</p></div>
				<span class="results-count">Showing 1–24 of 126 products</span>
			</section>

			<div class="shop-toolbar">
				<label class="shop-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search equipment, brands, or gear..." aria-label="Search equipment"></label>
				<div class="view-controls"><span>Sort by</span><button type="button" class="sort-button">Newest <span>⌄</span></button><button type="button" class="view-button active" aria-label="Grid view">▦</button><button type="button" class="view-button" aria-label="List view">▤</button></div>
			</div>

			<div class="shop-layout">
				<aside class="filter-panel" aria-label="Product filters">
					<div class="filter-heading"><strong>Filters</strong><small>Refine your search</small></div>
					<fieldset><legend>Category</legend><label><input type="checkbox"> Strength Training</label><label><input type="checkbox" checked> Cardio Equipment</label><label><input type="checkbox"> Recovery Gear</label></fieldset>
					<fieldset><legend>Price Range</legend><div class="price-inputs"><span>₹0</span><span>₹100000+</span></div><input class="range" type="range" min="0" max="100000" value="65000" aria-label="Maximum price"></fieldset>
					<button type="button" class="clear-filters">Clear All Filters</button>
				</aside>

				<section class="shop-results" aria-label="Products">
					<div class="shop-product-grid">
						<article class="shop-product-card"><span class="sale-tag">15% OFF</span><button class="wishlist" type="button" aria-label="Add treadmill to wishlist">♡</button><div class="shop-product-image treadmill"></div><small>APEX PRO</small><h2>Apex T-800 Pro Treadmill</h2><div class="product-meta"><span>★ 4.8</span><span>(120 reviews)</span></div><strong class="shop-price">₹299.00</strong><span class="stock-pill">In stock</span><button class="cart-button" type="button">▣ Add to Cart</button></article>
						<article class="shop-product-card"><span class="sale-tag">20% OFF</span><button class="wishlist" type="button" aria-label="Add elliptical trainer to wishlist">♡</button><div class="shop-product-image elliptical"></div><small>VITALITY ELITE</small><h2>Elite Adjustable Dumbbells</h2><div class="product-meta"><span>★ 4.7</span><span>(86 reviews)</span></div><strong class="shop-price">₹499.00</strong><span class="stock-pill">In stock</span><button class="cart-button" type="button">▣ Add to Cart</button></article>
						<article class="shop-product-card"><span class="sale-tag">20% OFF</span><button class="wishlist" type="button" aria-label="Add bicycle to wishlist">♡</button><div class="shop-product-image bicycle"></div><small>APEX RIDE</small><h2>Summit 03 Cycle</h2><div class="product-meta"><span>★ 4.9</span><span>(64 reviews)</span></div><strong class="shop-price">₹1,299.00</strong><span class="stock-pill">In stock</span><button class="cart-button" type="button">▣ Add to Cart</button></article>
						<article class="shop-product-card"><button class="wishlist" type="button" aria-label="Add bench to wishlist">♡</button><div class="shop-product-image bench"></div><small>APEX FORCE</small><h2>Olympic Bench Press 4x</h2><div class="product-meta"><span>★ 4.6</span><span>(38 reviews)</span></div><strong class="shop-price">₹349.00</strong><span class="stock-pill">In stock</span><button class="cart-button" type="button">▣ Add to Cart</button></article>
					</div>

					<div class="shop-promo"><div><strong>Upgrade Your<br>Home Gym</strong><button type="button">Shop Now</button></div></div>

					<div class="shop-product-grid secondary-products">
						<article class="shop-product-card"><button class="wishlist" type="button" aria-label="Add resistance bands to wishlist">♡</button><div class="shop-product-image bands"></div><small>FLEX PRO</small><h2>Basic Flow Sport Bands</h2><div class="product-meta"><span>★ 4.8</span><span>(42 reviews)</span></div><strong class="shop-price">₹179.00</strong><span class="stock-pill">In stock</span><button class="cart-button" type="button">▣ Add to Cart</button></article>
						<article class="shop-product-card placeholder-card"><div class="shop-product-image kettlebell"></div></article>
						<article class="shop-product-card placeholder-card"><div class="shop-product-image mats"></div></article>
						<article class="shop-product-card placeholder-card"><div class="shop-product-image accessories"></div></article>
					</div>

					<nav class="pagination" aria-label="Shop pages"><button type="button">‹</button><button type="button" class="current">1</button><button type="button">2</button><button type="button">3</button><button type="button">4</button><button type="button">›</button></nav>
				</section>
			</div>
		</main>
		<%- include('../partials/user-footer') %>
	</div>
</body>
</html>
