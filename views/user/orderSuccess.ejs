<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed | Fitpro Equips</title>
    <link rel="stylesheet" href="/css/landing.css">
    <style>
        :root {
            --success-blue: #096bf1;
            --success-ink: #1a273b;
            --success-muted: #748197;
            --success-line: #e4eaf4;
            --success-surface: #fff;
            --success-page: #f5f7fc;
        }

        .order-success-page {
            min-height: 100vh;
            color: var(--success-ink);
            background: var(--success-page);
        }

        .confirmation-main {
            width: min(1120px, calc(100% - 48px));
            margin: 0 auto;
            padding: 34px 0 58px;
        }

        .confirmation-card {
            width: min(620px, 100%);
            margin: 0 auto;
            padding: 26px 30px 22px;
            border: 1px solid #e7edf7;
            border-radius: 7px;
            background: #fff;
            box-shadow: 0 8px 25px rgba(31, 62, 115, .06);
            text-align: center;
        }

        .confirmation-mark {
            display: grid;
            width: 42px;
            height: 42px;
            margin: 0 auto 12px;
            place-items: center;
            border-radius: 50%;
            color: #137843;
            background: #77ed98;
        }

        .confirmation-mark svg { width: 21px; height: 21px; }
        .confirmation-title { margin: 0 0 4px; font-size: 23px; line-height: 1.2; }
        .confirmation-copy { max-width: 420px; margin: 0 auto 17px; color: var(--success-muted); font-size: 12px; line-height: 1.5; }

        .confirmation-facts {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            padding: 13px 0;
            border-top: 1px solid var(--success-line);
            border-bottom: 1px solid var(--success-line);
        }

        .confirmation-fact { min-width: 0; padding: 0 8px; }
        .confirmation-fact + .confirmation-fact { border-left: 1px solid var(--success-line); }
        .fact-label { display: block; margin-bottom: 5px; color: #8792a3; font-size: 9px; text-transform: uppercase; }
        .fact-value { display: block; color: var(--success-ink); font-size: 12px; font-weight: 600; }
        .fact-value.order-number { color: var(--success-blue); }
        .fact-value.paid { display: inline-flex; align-items: center; gap: 5px; color: #16824b; }
        .fact-value.pending { display: inline-flex; align-items: center; gap: 5px; color: #d97706; }
        
        .paid::before { width: 6px; height: 6px; border-radius: 50%; background: #20b66a; content: ""; }
        .pending::before { width: 6px; height: 6px; border-radius: 50%; background: #fbbf24; content: ""; }

        .invoice-button {
            display: inline-flex;
            min-height: 34px;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 16px;
            padding: 0 22px;
            border: 1px solid #d8e4f8;
            border-radius: 6px;
            color: #24344d;
            background: #eaf1ff;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

        .invoice-button svg { width: 14px; height: 14px; }
        .invoice-button:hover { background: #dfeaff; }

        .delivery-progress {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            position: relative;
            margin: 29px auto 26px;
            padding: 0 8px;
            list-style: none;
        }

        .delivery-progress::before,
        .delivery-progress::after {
            position: absolute;
            top: 8px;
            left: 10%;
            height: 2px;
            content: "";
        }

        .delivery-progress::before { right: 10%; background: #dce5f1; }
        .delivery-progress::after { width: 20%; background: var(--success-blue); }
        .progress-step { position: relative; z-index: 1; display: flex; min-width: 0; flex-direction: column; align-items: center; gap: 7px; color: #78869b; text-align: center; }
        .progress-icon { display: grid; width: 17px; height: 17px; place-items: center; border: 1px solid #d5dfed; border-radius: 50%; color: #8b9ab0; background: #eef3fb; }
        .progress-icon svg { width: 9px; height: 9px; }
        .progress-step.current { color: var(--success-blue); }
        .progress-step.current .progress-icon { border-color: var(--success-blue); color: #fff; background: var(--success-blue); }
        .progress-label { font-size: 10px; white-space: nowrap; }

        .order-content-grid {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(245px, .95fr);
            align-items: start;
            gap: 18px;
        }

        .order-items-panel,
        .information-panel,
        .summary-panel {
            border: 1px solid #e7edf6;
            border-radius: 7px;
            background: var(--success-surface);
            box-shadow: 0 4px 13px rgba(31, 62, 115, .035);
        }

        .order-items-panel { padding: 17px 18px 12px; }
        .panel-title { margin: 0 0 14px; font-size: 16px; font-weight: 650; }
        .order-item { display: grid; grid-template-columns: 62px minmax(0, 1fr) auto; align-items: start; gap: 13px; padding: 12px 0; }
        .order-item + .order-item { border-top: 1px solid #edf1f7; }
        .item-image { display: grid; width: 62px; height: 62px; place-items: center; overflow: hidden; border-radius: 5px; background: #f0f2f4; }
        .item-image img { width: 100%; height: 100%; object-fit: cover; }
        .item-copy { min-width: 0; padding-top: 2px; }
        .item-name { margin: 0 0 3px; font-size: 12px; font-weight: 650; line-height: 1.35; }
        .item-description { margin: 0 0 4px; color: var(--success-muted); font-size: 10px; line-height: 1.4; }
        .item-quantity { margin: 0; color: #37455b; font-size: 10px; }
        .item-price { padding-top: 3px; color: var(--success-blue); font-size: 12px; font-weight: 650; white-space: nowrap; }

        .order-aside { display: grid; gap: 13px; }
        .information-panel { padding: 15px 16px; }
        .aside-title { display: flex; align-items: center; gap: 7px; margin: 0 0 12px; color: #58677e; font-size: 11px; font-weight: 650; letter-spacing: .04em; text-transform: uppercase; }
        .aside-title svg { width: 13px; height: 13px; color: #3a4b64; }
        .shipping-name { margin: 0 0 4px; font-size: 12px; font-weight: 650; }
        .shipping-address,
        .shipping-phone { margin: 0; color: #65738a; font-size: 10px; line-height: 1.5; }
        .shipping-phone { margin-top: 6px; }

        .summary-panel { padding: 15px 16px 12px; }
        .summary-panel .aside-title { margin-bottom: 12px; }
        .summary-line { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 9px; color: #65738a; font-size: 10px; }
        .summary-line strong { color: #25344a; font-weight: 600; white-space: nowrap; }
        .summary-line .discount { color: #18834d; }
        .summary-line .free { color: #16824b; }
        .summary-total { display: flex; justify-content: space-between; gap: 12px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--success-line); font-size: 12px; }
        .summary-total strong { color: var(--success-blue); font-weight: 700; white-space: nowrap; }

        .order-actions { display: grid; gap: 9px; padding: 0 2px; }
        .order-action {
            display: flex;
            min-height: 38px;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid #d9e1ee;
            border-radius: 6px;
            color: #29384e;
            background: transparent;
            font-size: 11px;
            font-weight: 600;
            text-align: center;
            transition: background-color .16s ease, border-color .16s ease;
        }

        .order-action:hover { border-color: #b9cae5; background: #fff; }
        .order-action svg { width: 14px; height: 14px; flex: 0 0 auto; }

        @media (max-width: 650px) {
            .confirmation-main { width: min(100% - 32px, 560px); padding-top: 25px; }
            .confirmation-card { padding: 23px 18px 19px; }
            .order-content-grid { grid-template-columns: minmax(0, 1.7fr) minmax(185px, 1fr); gap: 12px; }
            .order-items-panel { padding: 14px 12px 10px; }
            .information-panel, .summary-panel { padding: 13px 12px; }
            .order-item { grid-template-columns: 50px minmax(0, 1fr) auto; gap: 9px; }
            .item-image { width: 50px; height: 50px; }
            .panel-title { font-size: 14px; }
        }

        @media (max-width: 470px) {
            .confirmation-main { width: calc(100% - 28px); padding-top: 20px; padding-bottom: 36px; }
            .confirmation-card { padding: 20px 13px 17px; }
            .confirmation-title { font-size: 20px; }
            .confirmation-copy { font-size: 11px; }
            .confirmation-fact { padding: 0 4px; }
            .fact-label { font-size: 8px; }
            .fact-value { font-size: 10px; }
            .delivery-progress { margin: 25px auto 21px; padding: 0; }
            .progress-label { font-size: 8px; }
            .order-content-grid { grid-template-columns: 1fr; }
            .order-aside { grid-template-columns: 1fr 1fr; align-items: start; }
            .order-actions { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; }
            .order-action { min-height: 36px; padding: 7px; font-size: 10px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
        }
    </style>
</head>
<body>
    <div class="order-success-page">
        <%- include('../partials/user-header', { currentPage: 'shop' }) %>

        <main class="confirmation-main">
            <section class="confirmation-card" aria-labelledby="confirmation-title">
                <div class="confirmation-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="8.5"></circle>
                        <path d="m8.5 12.2 2.2 2.2 4.8-5"></path>
                    </svg>
                </div>
                <h1 class="confirmation-title" id="confirmation-title">Order Placed Successfully!</h1>
                <p class="confirmation-copy">Thank you for your purchase. Your premium performance gear is being prepared.</p>

                <div class="confirmation-facts" aria-label="Order summary">
                    <div class="confirmation-fact">
                        <span class="fact-label">Order Number</span>
                        <span class="fact-value order-number"><%= order.orderId %></span>
                    </div>
                    <div class="confirmation-fact">
                        <span class="fact-label">Est. Delivery</span>
                        <span class="fact-value"><%= estimatedDelivery %></span>
                    </div>
                    <div class="confirmation-fact">
                        <span class="fact-label">Status</span>
                        <% if (order.paymentMethod === 'Cash on Delivery') { %>
                            <span class="fact-value pending">Payment Pending (COD)</span>
                        <% } else { %>
                            <span class="fact-value paid">Paid Successfully</span>
                        <% } %>
                    </div>
                </div>

                <button class="invoice-button" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v11m0 0 4-4m-4 4-4-4"></path>
                        <path d="M5 16v4h14v-4"></path>
                    </svg>
                    Download Invoice
                </button>
            </section>

            <ol class="delivery-progress" aria-label="Delivery progress">
                <li class="progress-step current" aria-current="step">
                    <span class="progress-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 12 4 4 8-8"></path></svg></span>
                    <span class="progress-label">Order Confirmed</span>
                </li>
                <li class="progress-step">
                    <span class="progress-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="16" rx="2"></rect><path d="M9 8h6M9 12h6M9 16h3"></path></svg></span>
                    <span class="progress-label">Preparing</span>
                </li>
                <li class="progress-step">
                    <span class="progress-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8 9-5 9 5-9 5-9-5Z"></path><path d="M3 8v9l9 5 9-5V8M12 13v9"></path></svg></span>
                    <span class="progress-label">Packed</span>
                </li>
                <li class="progress-step">
                    <span class="progress-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v11H3zM14 11h4l3 3v4h-7z"></path><circle cx="7.5" cy="19" r="1.5"></circle><circle cx="18" cy="19" r="1.5"></circle></svg></span>
                    <span class="progress-label">Shipped</span>
                </li>
                <li class="progress-step">
                    <span class="progress-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.5 2.5L16 9"></path></svg></span>
                    <span class="progress-label">Delivered</span>
                </li>
            </ol>

            <div class="order-content-grid">
                <section class="order-items-panel" id="order-items" aria-labelledby="order-items-title">
                    <h2 class="panel-title" id="order-items-title">Order Items</h2>
                    
                    <% order.items.forEach(item => { %>
                        <article class="order-item">
                            <div class="item-image"><img src="<%= item.image %>" alt="<%= item.name %>"></div>
                            <div class="item-copy">
                                <h3 class="item-name"><%= item.name %></h3>
                                <p class="item-quantity">Qty: <%= item.quantity %></p>
                            </div>
                            <span class="item-price">₹<%= item.price.toLocaleString('en-IN') %></span>
                        </article>
                    <% }); %>

                </section>

                <aside class="order-aside" aria-label="Order details">
                    <section class="information-panel" aria-labelledby="shipping-title">
                        <h2 class="aside-title" id="shipping-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                            Shipping Information
                        </h2>
                        <p class="shipping-name"><%= order.shippingAddress.name %></p>
                        <p class="shipping-address"><%= order.shippingAddress.fullAddress %></p>
                        <p class="shipping-phone"><%= order.shippingAddress.phone %></p>
                    </section>

                    <section class="summary-panel" aria-labelledby="summary-title">
                        <h2 class="aside-title" id="summary-title">Summary</h2>
                        <p class="summary-line"><span>Subtotal</span><strong>₹<%= order.subtotal.toLocaleString('en-IN') %></strong></p>
                        
                        <% if (order.discount > 0) { %>
                            <p class="summary-line"><span>Discount</span><strong class="discount">-₹<%= order.discount.toLocaleString('en-IN') %></strong></p>
                        <% } %>
                        
                        <p class="summary-line"><span>Shipping</span><strong class="<%= order.shippingCost === 0 ? 'free' : '' %>"><%= order.shippingCost === 0 ? 'FREE' : '₹' + order.shippingCost %></strong></p>
                        <p class="summary-line"><span>Estimated Tax (0.18%)</span><strong>₹<%= order.tax.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong></p>
                        
                        <div class="summary-total"><span>Total <%= order.paymentMethod === 'Cash on Delivery' ? 'to Pay' : 'Paid' %></span><strong>₹<%= order.grandTotal.toLocaleString('en-IN') %></strong></div>
                    </section>

                    <div class="order-actions">
                        <a class="order-action" href="/account/orders/<%= order._id %>">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h8M8 17h4"></path></svg>
                            View Full Details
                        </a>
                        <a class="order-action" href="/shop">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                            Continue Shopping
                        </a>
                    </div>
                </aside>
            </div>
        </main>

        <%- include('../partials/user-footer') %>
    </div>
    
    <script>
        // Order placed, empty cart badge
        const cartBadge = document.querySelector('[data-cart-count]');
        if (cartBadge) cartBadge.textContent = '0';
    </script>
</body>
</html>