<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Login | Fitpro Equips</title>
	<link rel="stylesheet" href="/css/login.css">
	<script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
	<div class="page-shell">
		<%- include('../partials/user-header') %>

		<main class="main-content">
			<section class="welcome-panel">
				<div class="welcome-copy">
					<h1>Welcome Back</h1>
					<p>Your peak performance journey continues here. Reconnect with your goals and unlock your next level of vitality.</p>
				</div>
			</section>

			<section class="login-panel">
				<div class="login-content">
					<div class="login-card">
						<h2>Login</h2>
						<p class="intro">Welcome back! Please enter your account<br>details.</p>
						<% if (typeof message !== 'undefined' && message) { %>
							<p class="error-message"><%= message %></p>
						<% } %>
						<form action="/login" method="POST">
							<div class="form-field">
								<label for="email">Email Address</label>
								<input id="email" name="email" type="email" placeholder="Email Address" autocomplete="email" required>
							</div>
							<div class="form-field password-field">
								<label for="password">Password</label>
								<input id="password" name="password" type="password" placeholder="Password" autocomplete="current-password" required>
								<button class="password-toggle" type="button" aria-label="Show password" data-password-toggle>
									<span class="icon eye-icon" aria-hidden="true"></span>
								</button>
							</div>
							<div class="form-options">
								<a class="forgot-link" href="/forgot-password">Forgot Password?</a>
							</div>
							<button class="sign-in-button" type="submit">Login</button>
						</form>
						<div class="divider"><span>OR</span></div>
						<!-- Google Identity Services Button Container -->
<div id="g_id_onload"
     data-client_id="<%= process.env.GOOGLE_CLIENT_ID || '822907466188-71ha5a3b1co64t0mf3o9e01tqskme85m.apps.googleusercontent.com' %>"
     data-context="signin"
     data-ux_mode="popup"
     data-callback="handleGoogleLogin"
     data-auto_prompt="false">
</div>
<div class="g_id_signin"
     data-type="standard"
     data-shape="rectangular"
     data-theme="outline"
     data-text="signin_with"
     data-size="large"
     data-logo_alignment="center"
     style="display: flex; justify-content: center; width: 100%; margin-bottom: 15px;">
</div>
						<p class="register-prompt">Don't have an account? <a href="/register">Register</a></p>
					</div>

					<div class="trust-row">
						<div class="trust-item"><span class="trust-icon lock-icon"></span><span>Secure Login</span></div>
						<div class="trust-item"><span class="trust-icon bolt-icon"></span><span>Fast Checkout</span></div>
						<div class="trust-item"><span class="trust-icon shield-icon"></span><span>Protected</span></div>
					</div>

					<div class="help-box">
						<h3>Need Help?</h3>
						<a href="#contact">Contact Support</a>
					</div>
				</div>
			</section>
		</main>

		<%- include('../partials/user-footer') %>
	</div>
	<script src="/js/login.js"></script>
	<script>
        async function handleGoogleLogin(response) {
            try {
                // Send the secure credential token to your backend
                const res = await fetch('/google-login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ credential: response.credential })
                });
                
                const data = await res.json();
                
                if (data.success) {
                    // Success! Redirect to the home page or dashboard
                    window.location.href = '/'; 
                } else {
					window.showAppModal(data.message || 'Login failed.', 'error');
                }
            } catch (error) {
                console.error('Fetch error:', error);
				window.showAppModal('Something went wrong connecting to the server. Please try again.', 'error');
            }
        }
    </script>
	<script>
		window.addEventListener('pageshow', async () => {
			try {
				const response = await fetch('/userProfile', {
					cache: 'no-store',
					credentials: 'same-origin'
				});

				if (response.ok && new URL(response.url).pathname === '/userProfile') {
					window.location.replace('/userProfile');
				}
			} catch (error) {
				console.error('User session check failed:', error);
			}
		});
	</script>
</body>
</html>
