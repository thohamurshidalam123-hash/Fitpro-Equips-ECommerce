<div class="contact-modal-overlay" id="contact-modal" data-contact-modal hidden>
    <section class="contact-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title" aria-describedby="contact-modal-subtitle">
        <div class="contact-modal-content">
            <header class="contact-modal-header">
                <span class="contact-modal-support-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-1a8 8 0 0 1 16 0v1"></path><path d="M4 13h3v6H6a2 2 0 0 1-2-2v-4Zm16 0h-3v6h1a2 2 0 0 0 2-2v-4Z"></path><path d="M17 19c-.8 1-2 1.5-4 1.5"></path></svg>
                </span>
                <div>
                    <h2 id="contact-modal-title">Contact Us</h2>
                    <p id="contact-modal-subtitle">We're here to help you anytime</p>
                </div>
            </header>

            <div class="contact-modal-options">
                <div class="contact-modal-option">
                    <span class="contact-modal-option-icon phone" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a15 15 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2C10 20.5 3.5 14 3 5a2 2 0 0 1 2-2Z"></path></svg>
                    </span>
                    <div class="contact-modal-option-copy">
                        <span class="contact-modal-label">PHONE</span>
                        <strong><%= supportPhone %></strong>
                    </div>
                    <button class="contact-modal-copy" type="button" data-copy-contact="<%= supportPhone %>" data-copy-name="Phone number" aria-label="Copy phone number" title="Copy phone number">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h2"></path></svg>
                    </button>
                </div>

                <div class="contact-modal-option">
                    <span class="contact-modal-option-icon email" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
                    </span>
                    <div class="contact-modal-option-copy">
                        <span class="contact-modal-label">EMAIL</span>
                        <strong><%= supportEmail %></strong>
                    </div>
                    <button class="contact-modal-copy" type="button" data-copy-contact="<%= supportEmail %>" data-copy-name="Email address" aria-label="Copy email address" title="Copy email address">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h2"></path></svg>
                    </button>
                </div>
            </div>

            <p class="contact-modal-availability"><span aria-hidden="true"></span>Support team available Monday - Saturday (9:00 AM - 6:00 PM)</p>
            <p class="contact-modal-status" data-contact-copy-status aria-live="polite"></p>
        </div>
        <footer class="contact-modal-footer">
            <button type="button" data-close-contact-modal>Close</button>
        </footer>
    </section>
</div>