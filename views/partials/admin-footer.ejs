<!-- Admin Footer Partial - Logout Modal -->
<div class="modal-overlay" id="logoutModal">
	<div class="modal-container">
		<div class="modal-header">
			<h3 class="modal-title">Confirm Logout</h3>
			<button class="modal-close" aria-label="Close modal">&times;</button>
		</div>
		<div class="modal-body">
			<p class="modal-message">Are you sure you want to logout?</p>
			<p class="modal-subtitle">You will be redirected to the login page.</p>
		</div>
		<div class="modal-footer">
			<button id="cancelLogout" class="btn btn-cancel">Cancel</button>
			<button id="confirmLogout" class="btn btn-confirm">Yes, Logout</button>
		</div>
	</div>
</div>
<link rel="stylesheet" href="/css/notification-modal.css">
<div class="app-notification-overlay" id="appNotification" role="dialog" aria-modal="true" aria-labelledby="appNotificationTitle" aria-describedby="appNotificationMessage">
	<div class="app-notification-modal" role="document">
		<div class="app-notification-icon" aria-hidden="true">!</div>
		<h2 class="app-notification-title" id="appNotificationTitle">Notice</h2>
		<p class="app-notification-message" id="appNotificationMessage"></p>
		<button class="app-notification-close" type="button">OK</button>
	</div>
</div>
<script src="/js/notification-modal.js"></script>

<script src="/js/admin-dashboard.js"></script>
