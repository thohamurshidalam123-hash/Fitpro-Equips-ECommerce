        <span class="cart-wrap"><span class="icon cart-icon" aria-hidden="true"></span><span class="cart-count" data-cart-count>0</span></span>
        <a class="icon user-icon <%= currentPage === 'login' ? 'active' : '' %>" href="/login" aria-label="Open login page" title="Login"></a>
