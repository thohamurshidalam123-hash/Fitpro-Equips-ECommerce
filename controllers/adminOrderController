const adminOrderService = require('../services/adminOrderService');

// For listing orders with search, filter, sort (descending) and pagination
const loadAdminOrders = async (req, res) => {
    try{
        const page = parseInt(req.query.page, 10) || 1;
        const search = req.query.search ? req.query.search.trim() : '';
        const data = await adminOrderService.getAdminOrders({
            page,
            search,
            status: req.query.status,
            payment: req.query.payment
        });

        res.render('admin/adminOrder', {
            currentPage: 'orders',
            ...data,
        });
    }catch(error) {
        console.error('Error in load admin order page:',error);
        res.status(500).json({ success: false, message: 'Server Error'});
    }
};

// For loading order details page
const loadAdminOrderDetails = async (req, res) => {
    try{
        const order = await adminOrderService.getAdminOrderDetails(req.params.id);
        
        if(!order) return res.redirect('/admin/orders');

        res.render('admin/adminOrderDetails', {
            currentPage: 'orders',
            order
        });
    }catch(error) {
        console.error('Error in load admin order details page:',error);
        res.status(500).json({ success: false, message: 'Server Errror'});
    }
};

// Updating order status
const updateOrderStatus = async (req, res) => {
    try {
        const { status } = req.body;
        const result = await adminOrderService.updateOrderStatus(req.params.id, status);
        if (!result.success) {
            return res.status(result.statusCode).json({ success: false, message: result.message });
        }

        res.json({ success: true, message: 'Order status updated successfully' });
    } catch (error) {
        console.error('Update Status Error:', error);
        res.status(500).json({ success: false, message: 'Server Error' });
    }
};


module.exports = {
    loadAdminOrders,
    loadAdminOrderDetails,
    updateOrderStatus
}